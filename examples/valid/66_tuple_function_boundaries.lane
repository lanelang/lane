module Examples.Valid.TupleFunctionBoundaries

import Basic.Data.Tuple
import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

fn apply_tuple(callee : ((I64, Bool)) -> I64, value : (I64, Bool)) -> I64 {
  callee(value)
}

fn apply_two(callee : (I64, Bool) -> I64, number : I64, enabled : Bool) -> I64 {
  callee(number, enabled)
}

fn read_tuple(value : (I64, Bool)) -> I64 {
  let (number, enabled) = value
  if enabled {
    number
  } else {
    0
  }
}

fn read_two(number : I64, enabled : Bool) -> I64 {
  if enabled {
    number
  } else {
    0
  }
}

pub fn answer() -> Unit ! Io {
  let from_tuple = apply_tuple(read_tuple, (40, true))
  let from_two = apply_two(read_two, 2, true)
  if from_tuple + from_two == 42 {
    println("tuple function boundaries=42")
  } else {
    println("tuple function boundaries failed")
  }
}
