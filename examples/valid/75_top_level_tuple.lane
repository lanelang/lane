module Examples.Valid.TopLevelTuple

import Basic.Data.Tuple
import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Data.Bool.*

pub let answer_pair : (I64, Bool) = (42, true)

pub fn answer() -> Unit ! Io {
  let (number, enabled) = answer_pair
  if enabled && number == 42 {
    println("top level tuple=42")
  } else {
    println("top level tuple failed")
  }
}
