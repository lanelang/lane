module Examples.Valid.F32Operations

import Basic.Data.F32.*
import Basic.Conv.I64.{ i64_impl_debug }
import Basic.Data.I64.{ i64_impl_equal }
import Basic.Data.List.{ List }
import Basic.Ops.*
import Test.Assert.{ Assert, assert_equal, assert_false, assert_true, execute_all_tests }

fn test_f32_operations() -> Unit ! Assert {
  offer source_info : String = "test_f32_operations"
  let one_and_half : F32 = 1.5f32
  let one : F32 = 1f32
  let one_half : F32 = 0.5f32
  let two = from_i64(2)
  let three : F32 = 3f32
  let three_and_half : F32 = 3.5f32
  let zero : F32 = 0f32
  let directly_rounded : F32 = 1.000000059604644775400625f32
  let next_after_one : F32 = 1.00000011920928955078125f32
  assert_true(one_and_half + two == three_and_half)
  assert_true(two - one_and_half == one_half)
  assert_true(one_and_half * two == three)
  assert_true(two / two == one)
  assert_true(-one_and_half < zero)
  assert_true(ninf < inf)
  assert_false(nan == nan)
  assert_equal(to_i64(from_f64(42.75)), 42)
  assert_true(from_f64(to_f64(one_and_half)) == one_and_half)
  assert_true(directly_rounded == next_after_one)
}

pub fn answer() -> Unit ! Io {
  [test_f32_operations]
    |> execute_all_tests()
}
