import {
  "Milky2018/buslane",
  "Milky2018/diagnostic/render" @diag_render,
  "Milky2018/lanec/artifact",
  "Milky2018/lanec/compile",
  "Milky2018/lanec/diagnostic" @compiler_diag,
  "Milky2018/lanec/executable",
  "Milky2018/lanec/format",
  "Milky2018/lanec/driver",
  "Milky2018/lanec/module/frontend" @module_frontend,
  "Milky2018/lane/lsp",
  "Milky2018/lane/terminal",
  "Milky2018/lane_runtime",
  "Milky2018/lane_runtime/wasm" @lane_wasm_runtime,
  "Milky2018/lane_wasm_abi" @wasm_abi,
  "Milky2018/wasm_core/types" @wasm_types,
  "Milky2018/wasmoon/runtime" @wasmoon_runtime,
  "moonbit-community/prettyprinter",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
