module Examples.Valid.ElseIfChain

import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Data.Bool.*
import Basic.Io.{ println }

pub fn choose(first : Bool, second : Bool) -> I64 {
  if first {
    1
  } else if second {
    2
  } else {
    3
  }
}

pub let first : I64 = choose(true, false)

pub let second : I64 = choose(false, true)

pub let fallback : I64 = choose(false, false)

pub fn answer() -> Unit ! Io {
  if first == 1 && second == 2 && fallback == 3 {
    println("1,2,3")
  } else {
    println("bad:1,2,3")
  }
}
