module Examples.Valid.HandlerResumeClosure

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

effect Console {
  read() -> I64
}

fn program() -> I64 {
  handle Console::read!() with {
    Console::read(resume) => {
      let callback : (I64) -> I64 = fn(value) {
        resume(value)
      }
      callback(42)
    }
  } final value {
    value
  }
}

pub fn answer() -> Unit ! Io {
  if program() == 42 {
    println("resume closure=42")
  } else {
    println("bad:resume closure")
  }
}
