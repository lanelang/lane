module Examples.Valid.StructuralDerivationEqual

import Basic.Data.List.*
import Basic.Data.Void.{ Void, absurd }
import Basic.Io.{ println }
import Basic.Trait.Derive.{ Deriver, Lift, Product, Recursive, Sum }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Iso.{ Iso }
import Basic.Ops.*
import Basic.Data.Bool.*
import Basic.Data.I64.{ i64_impl_equal }

struct Box[T] {
  value : T
}

struct Point {
  x : I64
  y : I64
}

struct Tree {
  value : I64
  children : List[Tree]
}

fn equal_unit() -> Equal[Unit] {
  Equal::{
    equal: fn(_left, _right) {
      true
    }
  }
}

fn[A, B] equal_product(equal_a : Equal[A], equal_b : Equal[B]) -> Equal[Product[A, B]] {
  Equal::{
    equal: fn(left, right) {
      equal_a.equal(left.head, right.head) && equal_b.equal(left.tail, right.tail)
    }
  }
}

fn equal_void() -> Equal[Void] {
  Equal::{
    equal: fn(left, _right) {
      absurd[Bool](left)
    }
  }
}

fn[A, B] equal_sum(equal_a : Equal[A], equal_b : Equal[B]) -> Equal[Sum[A, B]] {
  Equal::{
    equal: fn(left, right) {
      match left {
        here(left) =>
          match right {
            here(right) => equal_a.equal(left, right)
            there(_) => false
          }
        there(left) =>
          match right {
            here(_) => false
            there(right) => equal_b.equal(left, right)
          }
      }
    }
  }
}

fn[T, R] equal_iso(iso : Iso[T, R], representation : Equal[R]) -> Equal[T] {
  Equal::{
    equal: fn(left, right) {
      representation.equal(iso.to(left), iso.to(right))
    }
  }
}

offer derive_equal : Deriver[Equal] = Deriver::{
  unit: equal_unit,
  product: equal_product,
  void: equal_void,
  sum: equal_sum,
  field: fn[A](_info, equal) {
    equal
  },
  variant: fn[A](_info, equal) {
    equal
  },
  record: fn[T, R](_info, iso, representation) {
    equal_iso(iso, representation)
  },
  enumeration: fn[T, R](_info, iso, representation) {
    equal_iso(iso, representation)
  }
}

let recursive_equal : Recursive[Equal] = Recursive::{
  defer: fn[T](get_equal) {
    Equal::{
      equal: fn(left, right) {
        get_equal().equal(left, right)
      }
    }
  }
}

let list_equal_lift : Lift[Equal, List] = Lift::{
  lift: fn[A](equal) {
    list_impl_equal(equal=equal)
  }
}

fn build_i64_list_equal() -> Equal[List[I64]] {
  offer recursive_list_equal : Equal[List[I64]] = recursive_equal.defer(
    fn() {
      build_i64_list_equal()
    }
  )
  derive[Equal, List[I64]]()
}

fn build_tree_equal() -> Equal[Tree] {
  offer recursive_tree_equal : Equal[Tree] = recursive_equal.defer(
    fn() {
      build_tree_equal()
    }
  )
  offer children_equal : Equal[List[Tree]] = list_equal_lift.lift(recursive_tree_equal)
  derive[Equal, Tree]()
}

let box_equal : Equal[Box[I64]] = derive[Equal, Box[I64]]()

let list_equal : Equal[List[I64]] = build_i64_list_equal()

let point_equal : Equal[Point] = derive[Equal, Point]()

let tree_equal : Equal[Tree] = build_tree_equal()

fn leaf(value : I64) -> Tree {
  Tree::{ value, children: [] }
}

pub fn answer() -> Unit ! Io {
  let box_ok =
    box_equal.equal(Box::{ value: 1 }, Box::{ value: 1 })
      && !box_equal.equal(Box::{ value: 1 }, Box::{ value: 2 })
  let list_ok = list_equal.equal([1, 2], [1, 2]) && !list_equal.equal([1, 2], [1, 3])
  let point_ok =
    point_equal.equal(Point::{ x: 1, y: 2 }, Point::{ x: 1, y: 2 })
      && !point_equal.equal(Point::{ x: 1, y: 2 }, Point::{ x: 2, y: 1 })
  let tree_ok =
    tree_equal.equal(
      Tree::{ value: 1, children: [leaf(2), leaf(3)] },
      Tree::{ value: 1, children: [leaf(2), leaf(3)] }
    )
      && !tree_equal.equal(
        Tree::{ value: 1, children: [leaf(2), leaf(3)] },
        Tree::{ value: 1, children: [leaf(2), leaf(4)] }
      )
  if box_ok && list_ok && point_ok && tree_ok {
    println("derive equal: box list point tree")
  } else {
    println("derive equal failed")
  }
}
