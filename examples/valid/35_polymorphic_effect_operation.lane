module Examples.Valid.PolymorphicEffectOperation

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

effect Prompt {
  choose[A](A, A) -> A
}

fn choose_explicit() -> I64 ! Prompt {
  Prompt::choose![I64](40, 41)
}

fn choose_inferred() -> I64 ! Prompt {
  Prompt::choose!(1, 2)
}

pub let handled_value : I64 = {
  let first : I64 = handle choose_explicit() with {
    Prompt::choose[T](left, _right, resume) => resume(left)
  } final value {
    value
  }
  let second : I64 = handle choose_inferred() with {
    Prompt::choose[T](_left, right, resume) => resume(right)
  } final value {
    value
  }
  first + second
}

pub fn answer() -> Unit ! Io {
  if handled_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
