module Examples.Valid.HandleBlockSubject

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

effect Console {
  read() -> I64
}

pub let handled_value : I64 = {
  handle {
    let base : I64 = 40
    base + Console::read!()
  } with {
    Console::read(resume) => resume(2)
  } final value {
    value
  }
}

pub fn answer() -> Unit ! Io {
  if handled_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
