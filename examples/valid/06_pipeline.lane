module Examples.Valid06

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Data.Bool.*

pub fn add_three(a : I64, b : I64, c : I64) -> I64 {
  a + b + c
}

pub fn pipeline_call(x : I64) -> I64 {
  x
    |> add_three(1, 2)
}

pub fn pipeline_literal(x : I64) -> I64 {
  x
    |> fn(value : I64) {
      value + 1
    }
}

pub fn answer() -> Unit ! Io {
  if pipeline_call(39) == 42 && pipeline_literal(41) == 42 {
    println("pipeline=42")
  } else {
    println("bad:pipeline=42")
  }
}
