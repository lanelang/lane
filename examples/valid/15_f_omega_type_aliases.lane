// Valid: transparent type aliases, type-level lambdas, and higher-kinded
// type parameters normalize before value type checking and Buslane lowering.

module Examples.Valid15

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

pub struct Box[A] {
  value : A
}

pub type Id[A] = A

pub type ApplyI64[F : [Type] -> Type] = F[I64]

pub fn get(box : ApplyI64[Box]) -> Id[I64] {
  box.value
}

pub let aliased_value : Id[I64] = get(Box::{ value: 42 })

pub fn answer() -> Unit ! Io {
  if aliased_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
