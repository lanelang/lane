module Examples.Valid.ModuleQualifiedAccess

import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Io.{ println }
import Basic.Builtins

pub let sum_value : I64 = Basic.Builtins.i64_add(20, 22)

pub fn answer() -> Unit ! Io {
  if sum_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
