module Examples.Valid61

import Basic.Io.{ println }

pub offer fn offered_identity(value : I64) -> I64 {
  accept_identity()
  value
}

fn accept_identity(auto _transform : (I64) -> I64) -> Unit {
  ()
}

fn obtain(auto provider : () -> I64) -> I64 {
  provider()
}

pub fn local_answer() -> I64 {
  offer fn provide() -> I64 {
    42
  }
  obtain()
}

fn use_polymorphic(auto transform : [A](A) -> A) -> I64 {
  transform[I64](42)
}

offer fn[A] identity(value : A) -> A {
  value
}

pub let top_level_answer : I64 = offered_identity(42)

pub let polymorphic_answer : I64 = use_polymorphic()

pub fn answer() -> Unit ! Io {
  match local_answer() {
    42 =>
      match top_level_answer {
        42 =>
          match polymorphic_answer {
            42 => println("offered functions=42")
            _ => println("polymorphic offer failed")
          }
        _ => println("top-level offer failed")
      }
    _ => println("local offer failed")
  }
}
