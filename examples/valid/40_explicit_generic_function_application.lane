module Examples.Valid.ExplicitGenericFunctionApplication

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

effect Log {
  log(I64) -> Unit
}

effect Coroutine[_E : Effect] {
  yield() -> Unit
}

fn[A] id(value : A) -> A {
  value
}

fn[E : Effect] yield_once() -> Unit ! Coroutine[E] {
  Coroutine[E]::yield!()
}

fn handled_yield() -> I64 {
  handle yield_once[Log]() with {
    Coroutine[Log]::yield(resume) => resume(())
  } final _value {
    id[I64](42)
  }
}

fn explicit_id() -> I64 {
  {
    let id_i64 : (I64) -> I64 = id[I64]
    id[I64](id_i64(handled_yield()))
  }
}

pub fn answer() -> Unit ! Io {
  if explicit_id() == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
