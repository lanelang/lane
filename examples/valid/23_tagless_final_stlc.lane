module Examples.Valid23

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

pub struct Stlc[R : [Type] -> Type] {
  i64_lit : (I64) -> R[I64]
  bool_lit : (Bool) -> R[Bool]
  add : (R[I64], R[I64]) -> R[I64]
  eq_i64 : (R[I64], R[I64]) -> R[Bool]
  if_i64 : (R[Bool], R[I64], R[I64]) -> R[I64]
  lam_i64 : ((R[I64]) -> R[I64]) -> R[(I64) -> I64]
  app_i64 : (R[(I64) -> I64], R[I64]) -> R[I64]
}

pub struct Eval[A] {
  value : A
}

pub struct Size[_A] {
  size : I64
}

pub fn eval_i64_lit(value : I64) -> Eval[I64] {
  Eval::{ value }
}

pub fn eval_bool_lit(value : Bool) -> Eval[Bool] {
  Eval::{ value }
}

pub fn eval_add(left : Eval[I64], right : Eval[I64]) -> Eval[I64] {
  Eval::{ value: left.value + right.value }
}

pub fn eval_eq_i64(left : Eval[I64], right : Eval[I64]) -> Eval[Bool] {
  Eval::{ value: left.value == right.value }
}

pub fn eval_if_i64(
  condition : Eval[Bool],
  then_branch : Eval[I64],
  else_branch : Eval[I64]
) -> Eval[I64] {
  if condition.value {
    then_branch
  } else {
    else_branch
  }
}

pub fn eval_lam_i64(body : (Eval[I64]) -> Eval[I64]) -> Eval[(I64) -> I64] {
  Eval::{
    value: fn(input : I64) {
      body(Eval::{ value: input }).value
    }
  }
}

pub fn eval_app_i64(function : Eval[(I64) -> I64], argument : Eval[I64]) -> Eval[I64] {
  Eval::{ value: function.value(argument.value) }
}

pub fn size_i64_lit(_value : I64) -> Size[I64] {
  Size::{ size: 1 }
}

pub fn size_bool_lit(_value : Bool) -> Size[Bool] {
  Size::{ size: 1 }
}

pub fn size_add(left : Size[I64], right : Size[I64]) -> Size[I64] {
  Size::{ size: 1 + left.size + right.size }
}

pub fn size_eq_i64(left : Size[I64], right : Size[I64]) -> Size[Bool] {
  Size::{ size: 1 + left.size + right.size }
}

pub fn size_if_i64(
  condition : Size[Bool],
  then_branch : Size[I64],
  else_branch : Size[I64]
) -> Size[I64] {
  Size::{ size: 1 + condition.size + then_branch.size + else_branch.size }
}

pub fn size_lam_i64(body : (Size[I64]) -> Size[I64]) -> Size[(I64) -> I64] {
  let body_size = body(Size::{ size: 1 })
  Size::{ size: 1 + body_size.size }
}

pub fn size_app_i64(function : Size[(I64) -> I64], argument : Size[I64]) -> Size[I64] {
  Size::{ size: 1 + function.size + argument.size }
}

pub let eval_stlc : Stlc[Eval] = Stlc::{
  i64_lit: eval_i64_lit,
  bool_lit: eval_bool_lit,
  add: eval_add,
  eq_i64: eval_eq_i64,
  if_i64: eval_if_i64,
  lam_i64: eval_lam_i64,
  app_i64: eval_app_i64
}

pub let size_stlc : Stlc[Size] = Stlc::{
  i64_lit: size_i64_lit,
  bool_lit: size_bool_lit,
  add: size_add,
  eq_i64: size_eq_i64,
  if_i64: size_if_i64,
  lam_i64: size_lam_i64,
  app_i64: size_app_i64
}

pub fn[R : [Type] -> Type] object_program(stlc : Stlc[R]) -> R[I64] {
  let inc : R[(I64) -> I64] = stlc.lam_i64(
    fn(x) {
      stlc.add(x, stlc.i64_lit(1))
    }
  )
  let result : R[I64] = stlc.app_i64(inc, stlc.i64_lit(41))
  stlc.if_i64(stlc.eq_i64(result, stlc.i64_lit(42)), result, stlc.i64_lit(0))
}

pub let evaluated : Eval[I64] = object_program(eval_stlc)

pub let measured : Size[I64] = object_program(size_stlc)

pub let measured_size : I64 = measured.size

pub let evaluated_value : I64 = evaluated.value

pub fn answer() -> Unit ! Io {
  if evaluated_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
