module ExternalHostTypes

pub extern type Vector : Type

pub extern type VectorIo : Effect

pub let vector_new : (I64) -> Vector ! VectorIo = extern("vector.new")

pub let vector_get : (Vector, I64) -> I64 ! VectorIo = extern("vector.get")

pub let vector_set : (Vector, I64, I64) -> Unit ! VectorIo = extern("vector.set")

pub let vector_close : (Vector) -> Unit ! VectorIo = extern("vector.close")
