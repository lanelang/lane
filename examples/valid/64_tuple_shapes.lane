module Examples.Valid.TupleShapes

import Basic.Data.Tuple
import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

fn flat_score(value : (I64, Bool, String)) -> I64 {
  let (number, enabled, _label) = value
  if enabled {
    number
  } else {
    0
  }
}

fn left_nested_score(value : ((I64, Bool), String)) -> I64 {
  let ((number, enabled), _label) = value
  if enabled {
    number
  } else {
    0
  }
}

pub fn answer() -> Unit ! Io {
  let flat = flat_score((40, true, "flat"))
  let left_nested = left_nested_score(((2, true), "left"))
  if flat + left_nested == 42 {
    println("tuple shapes=42")
  } else {
    println("tuple shapes failed")
  }
}
