module Examples.Valid.PipelineEffectHandlers

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

effect Ask {
  read() -> I64
}

effect Log {
  write(I64) -> Unit
}

fn program() -> I64 ! { Ask, Log } {
  let value : I64 = Ask::read!()
  let _written : Unit = Log::write!(value + 1)
  value + 2
}

fn[A, E : Effect] handle_ask(task : () -> A ! { Ask, E }) -> () -> A ! E {
  fn() {
    handle task() with {
      Ask::read(resume) => resume(40)
    } final value {
      value
    }
  }
}

fn[A, E : Effect] handle_log(task : () -> A ! { Log, E }) -> () -> A ! E {
  fn() {
    handle task() with {
      Log::write(_value, resume) => resume(())
    } final value {
      value
    }
  }
}

pub let handled_value : I64 =
  (program
    |> handle_ask
    |> handle_log)()

pub fn answer() -> Unit ! Io {
  if handled_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
