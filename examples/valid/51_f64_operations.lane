module Examples.Valid.F64Operations

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.F64.*
import Basic.Data.Bool.*

pub fn answer() -> Unit ! Io {
  if !(1.5 + 2.5 == 4.0) {
    println("f64 add or equal failed")
  } else if !(6.0 / 2.0 == 3.0) {
    println("f64 div failed")
  } else if !(5.0 - 1.0 == 4.0) {
    println("f64 sub failed")
  } else if !(2.0 * 3.0 == 6.0) {
    println("f64 mul failed")
  } else if !(-1.0 < 0.0) {
    println("f64 neg or less failed")
  } else if !(2.0 >= 2.0) {
    println("f64 greater_eq failed")
  } else {
    println("f64 operations ok")
  }
}
