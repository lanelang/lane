module Examples.Valid.SingleVariantPatternLet

import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Io.{ println }

pub enum Id[A] {
  id(A)
}

pub enum Packed {
  hide[T](T)
}

pub fn unwrap(value : Id[I64]) -> I64 {
  {
    let id(x) = value
    x
  }
}

pub fn repack(p : Packed) -> Packed {
  {
    let hide[T](value) = p
    Packed::hide[T](value)
  }
}

pub let wrapped_i64 : Id[I64] = Id::id(42)

pub let unwrapped_i64 : I64 = unwrap(wrapped_i64)

pub let packed_i64 : Packed = Packed::hide[I64](42)

pub let repacked_i64 : Packed = repack(packed_i64)

pub fn answer() -> Unit ! Io {
  if unwrapped_i64 == 42 {
    println("pattern-let=42")
  } else {
    println("bad:pattern-let")
  }
}
