module Examples.Valid.StateEffect

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

pub struct StateResult {
  value : I64
  state : I64
}

effect State {
  get() -> I64
  put(I64) -> Unit
}

fn tick() -> I64 ! State {
  let current : I64 = State::get!()
  let _updated : Unit = State::put!(current + 1)
  State::get!()
}

fn run_tick() -> (I64) -> StateResult {
  handle tick() with {
    State::get(resume) => fn(state : I64) -> StateResult {
      resume(state)(state)
    }
    State::put(next, resume) => fn(_state : I64) -> StateResult {
      resume(())(next)
    }
  } final value {
    fn(state : I64) -> StateResult {
      StateResult::{ value, state }
    }
  }
}

pub let result : StateResult = run_tick()(41)

pub let state_value : I64 = result.value

pub fn answer() -> Unit ! Io {
  if state_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
