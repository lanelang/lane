module Examples.Valid.TupleOpenImport

import Basic.Data.Tuple.*
import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Data.Bool.*

pub fn answer() -> Unit ! Io {
  let pair : (I64, Bool) = (42, true)
  let (number, enabled) = pair
  if enabled && number == 42 {
    println("tuple open import=42")
  } else {
    println("tuple open import failed")
  }
}
