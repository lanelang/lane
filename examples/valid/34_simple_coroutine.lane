module Examples.Valid.SimpleCoroutine

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

effect Coroutine {
  yield(I64) -> I64
}

pub enum CoroutineStep {
  done(I64)
  yielded(I64, (I64) -> CoroutineStep)
}

fn worker() -> I64 ! Coroutine {
  let first : I64 = Coroutine::yield!(1)
  let second : I64 = Coroutine::yield!(first + 10)
  second + 100
}

fn start() -> CoroutineStep {
  handle worker() with {
    Coroutine::yield(value, resume) => yielded(
      value,
      fn(input : I64) -> CoroutineStep {
        resume(input)
      }
    )
  } final value {
    done(value)
  }
}

fn drive(step : CoroutineStep) -> I64 {
  match step {
    done(value) => value
    yielded(value, resume) => value + drive(resume(value * 2))
  }
}

pub let coroutine_total : I64 = drive(start())

pub fn answer() -> Unit ! Io {
  if coroutine_total == 137 {
    println("137")
  } else {
    println("bad:137")
  }
}
