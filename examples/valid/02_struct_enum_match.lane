module Examples.Valid02

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.Bool.*
import Basic.Data.I64.*

pub struct Point {
  x : I64
  y : I64
}

pub enum Option[A] {
  none()
  some(A)
}

pub fn unwrap_or(value : Option[I64], fallback : I64) -> I64 {
  match value {
    none() => fallback
    some(x) => x
  }
}

pub fn sum_point(point : Point) -> I64 {
  match point {
    Point::{ x, y } => x + y
  }
}

pub let origin : Point = Point::{ x: 0, y: 0 }

pub let chosen : Option[I64] = some(1)

pub fn answer() -> Unit ! Io {
  if sum_point(origin) == 0 && unwrap_or(chosen, 0) == 1 {
    println("point=0 option=1")
  } else {
    println("bad:point=0 option=1")
  }
}
