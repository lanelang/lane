// Valid: higher-kinded alias header parameters must carry explicit kind
// annotations.

module Examples.Valid18

import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Io.{ println }

pub struct Box[A] {
  value : A
}

pub type ApplyI64[F : [Type] -> Type] = F[I64]

pub fn get(box : ApplyI64[Box]) -> I64 {
  box.value
}

pub let higher_kind_value : I64 = get(Box::{ value: 42 })

pub fn answer() -> Unit ! Io {
  if higher_kind_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
