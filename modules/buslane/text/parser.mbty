%derive<Debug> Token
%derive<Eq> TokenKind
%derive<Hash> TokenKind
%derive<Compare> TokenKind
%position<SourceSpan>
%derive<Debug> ParseError

%start buslane_program
%start buslane_type

%token<String> INT
%token<String> FLOAT_BITS
%token<String> STRING
%token<Int> TYPE_ID
%token<Int> TPARAM_ID
%token<Int> VALUE_ID
%token<Int> DATACON_ID
%token<Int> EFFECT_ID
%token<Int> OPERATION_ID
%token EOF
%token BUSLANE "buslane"
%token METADATA "metadata"
%token TYPE "type"
%token TYPE_PARAMETER "type_parameter"
%token VALUE "value"
%token DATACON "datacon"
%token EFFECT_DECL "effect"
%token OPERATION "operation"
%token FUNCTION_KIND "function"
%token PARAMETER_KIND "parameter"
%token LOCAL_KIND "local"
%token MATCH_BINDER_KIND "match_binder"
%token TYPE_KIND "Type"
%token EFFECT_KIND "Effect"
%token UNIT_TYPE "Unit"
%token BOOL_TYPE "Bool"
%token I64_TYPE "I64"
%token I32_TYPE "I32"
%token CHAR_TYPE "Char"
%token F32_TYPE "F32"
%token F64_TYPE "F64"
%token STRING_TYPE "String"
%token BYTE_TYPE "Byte"
%token BYTES_TYPE "Bytes"
%token IO "Io"
%token FORALL "forall"
%token IN "in"
%token AS "as"
%token FINAL "final"
%token UNDERSCORE "_"
%token LET "let"
%token LETREC "letrec"
%token EXTERNAL "external"
%token FN "fn"
%token PERFORM "perform"
%token HANDLE "handle"
%token RESUME "resume"
%token MATCH "match"
%token TRUE "true"
%token FALSE "false"
%token I32_LITERAL "i32"
%token CHAR_LITERAL "char"
%token F32_LITERAL "f32"
%token F64_LITERAL "f64"
%token LBRACE "{"
%token RBRACE "}"
%token LBRACKET "["
%token RBRACKET "]"
%token LPAREN "("
%token RPAREN ")"
%token COMMA ","
%token COLON ":"
%token SEMI ";"
%token EQUAL "="
%token FAT_ARROW "=>"
%token ARROW "->"
%token BANG "!"
%token DOT "."
%token HASH "#"

%%

buslane_program -> Program
  : "buslane" "{" metadata top_terms "}" EOF {
    { metadata: $3, terms: $4 }
  }
  ;

buslane_type -> Type
  : type EOF { $1 }
  ;

metadata -> MetadataRegistry
  : "metadata" "{" metadata_declarations "}" {
    make_metadata($3)
  }
  ;

metadata_declarations -> Array[MetadataDeclaration]
  : { [] }
  | metadata_declarations metadata_declaration { comma_push($1, $2) }
  ;

metadata_declaration -> MetadataDeclaration
  : external_marker "type" type_id "=" buslane_name type_parameter_ids data_con_ids ";" {
    TypeInfoDecl($3, {
      name: parsed_name(TypeName, $5.occurrence, $5.unique),
      flavor: if $1 { External } else { Data },
      parameters: $6,
      constructors: $7,
    })
  }
  | external_marker "type_parameter" type_parameter_id "=" buslane_name ":" kind ";" {
    TypeParameterInfoDecl($3, {
      name: parsed_name(TypeParameterName, $5.occurrence, $5.unique),
      kind: $7,
      flavor: if $1 { External } else { Algebraic },
    })
  }
  | "datacon" data_con_id "=" buslane_name type_parameter_ids "(" type_list ")" ":" type_id ";" {
    DataConInfoDecl($2, {
      name: parsed_name(DataConstructorName, $4.occurrence, $4.unique),
      owner: $10,
      hidden_type_parameters: $5,
      payload_types: $7,
    })
  }
  | "value" value_id "=" buslane_name value_kind ":" type ";" {
    ValueInfoDecl($2, {
      name: parsed_name(ValueName, $4.occurrence, $4.unique),
      kind: $5,
      type_: $7,
    })
  }
  | external_marker "effect" effect_id "=" buslane_name type_parameter_ids operation_ids ";" {
    EffectInfoDecl($3, {
      name: parsed_name(EffectName, $5.occurrence, $5.unique),
      flavor: if $1 { External } else { Algebraic },
      parameters: $6,
      operations: $7,
    })
  }
  | "operation" operation_id "=" buslane_name type_parameter_ids "(" type_list ")" "->" type ":" effect_id ";" {
    OperationInfoDecl($2, {
      name: parsed_name(OperationName, $4.occurrence, $4.unique),
      owner: $12,
      hidden_type_parameters: $5,
      payload_types: $7,
      result_type: $10,
    })
  }
  ;

external_marker -> Bool
  : { false }
  | "external" { true }
  ;

buslane_name -> ParsedBuslaneName
  : STRING "#" INT { { occurrence: $1, unique: parse_text_int($3) } }
  ;

top_terms -> Array[TopTerm]
  : { [] }
  | top_terms top_term { comma_push($1, $2) }
  ;

top_term -> TopTerm
  : "let" value_id "=" expr { Let($2, $4) }
  | "letrec" "{" recursive_bindings "}" { LetRec($3) }
  | "external" value_id { External($2) }
  ;

recursive_bindings -> Array[RecursiveBinding]
  : { [] }
  | recursive_bindings recursive_binding { comma_push($1, $2) }
  ;

recursive_binding -> RecursiveBinding
  : value_id "=" expr { { id: $1, rhs: $3 } }
  ;

expr -> Expr
  : postfix_expr { $1 }
  | "let" value_id "=" expr "in" expr { Let($2, $4, $6) }
  | "letrec" "{" recursive_bindings "}" "in" expr { LetRec($3, $6) }

  ;

postfix_expr -> Expr
  : atom_expr { $1 }
  | postfix_expr "(" expr_list ")" { Call($1, $3) }
  | postfix_expr "[" generic_arguments "]" { TypeApply($1, $3) }
  ;

atom_expr -> Expr
  : value_id { Ref($1) }
  | literal { Literal($1) }
  | "(" expr ")" { $2 }
  | data_con_id argument_group "(" expr_list ")" {
    Construct({
      data_constructor: $1,
      type_arguments: $2.0,
      hidden_witnesses: $2.1,
      payloads: $4,
    })
  }
  | "resume" value_id { Resume($2) }
  | "perform" operation_id argument_group "(" expr_list ")" {
    Perform({
      operation: $2,
      effect_arguments: $3.0,
      hidden_witnesses: $3.1,
      payloads: $5,
    })
  }
  | "fn" "(" value_id_list ")" "->" type "{" expr "}" {
    Function({ parameters: $3, result_type: $6, body: $8 })
  }
  | "fn" "[" type_parameter_id_list "]" "{" expr "}" { TypeLambda($3, $6) }
  | "match" expr "as" value_id "->" type "{" alternatives "}" {
    Match({ scrutinee: $2, binder: $4, result_type: $6, alternatives: $8 })
  }
  | "handle" expr "as" value_id "->" type "{" handler_tables "final" "=>" expr "}" {
    Handle({
      body: $2,
      result_binder: $4,
      result_type: $6,
      final_body: $11,
      handlers: $8,
    })
  }
  ;

argument_group -> (Array[GenericArgument], Array[GenericArgument])
  : { ([], []) }
  | "[" generic_arguments "]" { ($2, []) }
  | "[" generic_arguments ";" generic_arguments "]" { ($2, $4) }
  ;

handler_tables -> Array[HandlerTable]
  : { [] }
  | handler_tables handler_table { comma_push($1, $2) }
  ;

handler_table -> HandlerTable
  : effect "{" operation_alternatives "}" {
    { handled_effect: $1, operations: $3 }
  }
  ;

operation_alternatives -> Array[OperationAlternative]
  : { [] }
  | operation_alternatives operation_alternative { comma_push($1, $2) }
  ;

operation_alternative -> OperationAlternative
  : operation_id type_parameter_ids "(" value_id_list ")" "resume" value_id "=>" expr {
    {
      operation: $1,
      type_binders: $2,
      payload_binders: $4,
      resume_binder: $7,
      body: $9,
    }
  }
  ;

alternatives -> Array[Alternative]
  : { [] }
  | alternatives alternative { comma_push($1, $2) }
  ;

alternative -> Alternative
  : "_" "=>" expr {
    { alt_constructor: Default, type_binders: [], value_binders: [], body: $3 }
  }
  | literal "=>" expr {
    {
      alt_constructor: Literal($1),
      type_binders: [],
      value_binders: [],
      body: $3,
    }
  }
  | data_con_id type_parameter_ids "(" value_id_list ")" "=>" expr {
    {
      alt_constructor: DataCon($1),
      type_binders: $2,
      value_binders: $4,
      body: $7,
    }
  }
  ;

literal -> Literal
  : "(" ")" { Unit }
  | TRUE { Bool(true) }
  | FALSE { Bool(false) }
  | INT { validated_literal(parse_i64_literal($1)) }
  | "i32" "(" INT ")" { validated_literal(parse_i32_literal($3)) }
  | "char" "(" INT ")" { validated_literal(parse_char_literal($3)) }
  | "f32" "(" FLOAT_BITS ")" { validated_literal(parse_f32_bits($3)) }
  | "f64" "(" FLOAT_BITS ")" { validated_literal(parse_f64_bits($3)) }
  | STRING { String($1) }
  ;

kind -> Kind
  : "Type" { Type }
  | "Effect" { Effect }
  | "[" kind_list "]" "->" kind { Function($2, $5) }
  ;

type -> Type
  : arrow_type { $1 }
  | "forall" "[" type_parameter_id_list "]" "." type { Forall($3, $6) }
  | "type" "[" type_parameter_id_list "]" "=>" type { TypeLambda($3, $6) }
  ;

arrow_type -> Type
  : applied_type { $1 }
  | paren_types "->" applied_type { Function($1, $3, Empty) }
  | paren_types "->" applied_type "!" effect { Function($1, $3, $5) }
  ;

paren_types -> Array[Type]
  : "(" type_list ")" { $2 }
  ;

applied_type -> Type
  : atom_type { $1 }
  | applied_type "[" generic_arguments "]" { Apply($1, $3) }
  ;

atom_type -> Type
  : primitive_type { Primitive($1) }
  | type_parameter_id { Parameter($1) }
  | type_id { Constructor($1) }
  | paren_types { parenthesized_type($1) }
  ;

effect -> Effect
  : "{" "}" { Empty }
  | "Io" { Io }
  | type_parameter_id { Parameter($1) }
  | effect_id { Singleton($1, []) }
  | effect_id "[" non_empty_generic_arguments "]" { Singleton($1, $3) }
  | "{" non_empty_effect_list "}" { Union($2) }
  ;

primitive_type -> PrimitiveType
  : "Unit" { Unit }
  | "Bool" { Bool }
  | "I64" { I64 }
  | "I32" { I32 }
  | "Char" { Char }
  | "F32" { F32 }
  | "F64" { F64 }
  | "String" { String }
  | "Byte" { Byte }
  | "Bytes" { Bytes }
  ;

value_kind -> ValueKind
  : "function" { Function }
  | "value" { Value }
  | "external" { External }
  | "parameter" { Parameter }
  | "local" { Local }
  | "match_binder" { MatchBinder }
  ;

generic_argument -> GenericArgument
  : type { TypeArgument($1) }
  | "!" effect { EffectArgument($2) }
  ;

generic_arguments -> Array[GenericArgument]
  : { [] }
  | non_empty_generic_arguments { $1 }
  ;

non_empty_generic_arguments -> Array[GenericArgument]
  : generic_argument { [ $1 ] }
  | non_empty_generic_arguments "," generic_argument { comma_push($1, $3) }
  ;

kind_list -> Array[Kind]
  : { [] }
  | non_empty_kind_list { $1 }
  ;

non_empty_kind_list -> Array[Kind]
  : kind { [ $1 ] }
  | non_empty_kind_list "," kind { comma_push($1, $3) }
  ;

type_list -> Array[Type]
  : { [] }
  | non_empty_type_list { $1 }
  ;

non_empty_type_list -> Array[Type]
  : type { [ $1 ] }
  | non_empty_type_list "," type { comma_push($1, $3) }
  ;

non_empty_effect_list -> Array[Effect]
  : effect { [ $1 ] }
  | non_empty_effect_list "," effect { comma_push($1, $3) }
  ;

expr_list -> Array[Expr]
  : { [] }
  | non_empty_expr_list { $1 }
  ;

non_empty_expr_list -> Array[Expr]
  : expr { [ $1 ] }
  | non_empty_expr_list "," expr { comma_push($1, $3) }
  ;

type_parameter_ids -> Array[TypeParameterId]
  : { [] }
  | "[" non_empty_type_parameter_ids "]" { $2 }
  ;

type_parameter_id_list -> Array[TypeParameterId]
  : { [] }
  | non_empty_type_parameter_ids { $1 }
  ;

non_empty_type_parameter_ids -> Array[TypeParameterId]
  : type_parameter_id { [ $1 ] }
  | non_empty_type_parameter_ids "," type_parameter_id { comma_push($1, $3) }
  ;

value_id_list -> Array[ValueId]
  : { [] }
  | non_empty_value_id_list { $1 }
  ;

non_empty_value_id_list -> Array[ValueId]
  : value_id { [ $1 ] }
  | non_empty_value_id_list "," value_id { comma_push($1, $3) }
  ;

data_con_ids -> Array[DataConId]
  : "{" "}" { [] }
  | "{" non_empty_data_con_ids "}" { $2 }
  ;

non_empty_data_con_ids -> Array[DataConId]
  : data_con_id { [ $1 ] }
  | non_empty_data_con_ids "," data_con_id { comma_push($1, $3) }
  ;

operation_ids -> Array[OperationId]
  : "{" "}" { [] }
  | "{" non_empty_operation_ids "}" { $2 }
  ;

non_empty_operation_ids -> Array[OperationId]
  : operation_id { [ $1 ] }
  | non_empty_operation_ids "," operation_id { comma_push($1, $3) }
  ;

type_id -> TypeId
  : TYPE_ID { { index: $1 } }
  ;

type_parameter_id -> TypeParameterId
  : TPARAM_ID { { index: $1 } }
  ;

value_id -> ValueId
  : VALUE_ID { { index: $1 } }
  ;

data_con_id -> DataConId
  : DATACON_ID { { index: $1 } }
  ;

effect_id -> EffectId
  : EFFECT_ID { { index: $1 } }
  ;

operation_id -> OperationId
  : OPERATION_ID { { index: $1 } }
  ;
