module Examples.Valid.EffectfulFunctionCalls

import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Io.{ println }

effect Console {
  read() -> I64
}

fn read_i64() -> I64 ! Console {
  Console::read!()
}

fn call_read(f : () -> I64 ! Console) -> I64 ! Console {
  f()
}

pub let handled_value : I64 = {
  handle call_read(read_i64) with {
    Console::read(resume) => resume(42)
  } final value {
    value
  }
}

pub fn answer() -> Unit ! Io {
  if handled_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
