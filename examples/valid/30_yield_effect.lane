module Examples.Valid.YieldEffect

import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.I64.*

pub enum I64List {
  nil()
  cons(I64, I64List)
}

pub fn sum(list : I64List) -> I64 {
  match list {
    nil() => 0
    cons(head, tail) => head + sum(tail)
  }
}

effect Yield {
  emit(I64) -> Unit
}

fn produce() -> I64 ! Yield {
  let _first : Unit = Yield::emit!(10)
  let _second : Unit = Yield::emit!(20)
  12
}

pub let emitted : I64List = {
  handle produce() with {
    Yield::emit(value, resume) => cons(value, resume(()))
  } final value {
    cons(value, I64List::nil())
  }
}

pub let emitted_sum : I64 = sum(emitted)

pub fn answer() -> Unit ! Io {
  if emitted_sum == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
