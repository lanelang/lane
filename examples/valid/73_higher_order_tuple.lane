module Examples.Valid.HigherOrderTuple

import Basic.Data.Tuple
import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.Bool.*
import Basic.Data.I64.*

fn apply_transforms(transforms : ((I64) -> I64, (Bool) -> Bool)) -> (I64, Bool) {
  let (transform_i64, transform_bool) = transforms
  let result = (transform_i64(41), transform_bool(false))
  result
}

pub fn answer() -> Unit ! Io {
  let transforms : ((I64) -> I64, (Bool) -> Bool) =
    (
      fn(value) {
        value + 1
      },
      fn(flag) {
        !flag
      }
    )
  let (number, enabled) = apply_transforms(transforms)
  if enabled && number == 42 {
    println("higher order tuple=42")
  } else {
    println("higher order tuple failed")
  }
}
