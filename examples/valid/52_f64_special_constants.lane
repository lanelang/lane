module Examples.Valid.F64SpecialConstants

import Basic.Builtins.{ f64_inf, f64_nan, f64_ninf }
import Basic.Io.{ println }
import Basic.Ops.*
import Basic.Data.F64.*

pub fn answer() -> Unit ! Io {
  if f64_inf > 1.0 {
    if f64_ninf < 0.0 {
      if f64_nan != f64_nan {
        println("f64 constants ok")
      } else {
        println("nan equality failed")
      }
    } else {
      println("negative infinity comparison failed")
    }
  } else {
    println("infinity comparison failed")
  }
}
