module Examples.Valid.ExceptionEffect

import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Io.{ println }

effect Exception {
  raise(I64) -> I64
}

fn fail_with_answer() -> I64 ! Exception {
  Exception::raise!(42)
}

pub let handled_value : I64 = {
  handle fail_with_answer() with {
    Exception::raise(code, _resume) => code
  } final value {
    value
  }
}

pub fn answer() -> Unit ! Io {
  if handled_value == 42 {
    println("42")
  } else {
    println("bad:42")
  }
}
