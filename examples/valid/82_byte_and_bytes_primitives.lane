module Examples.Valid.ByteAndBytesPrimitives

import Basic.Builtins.{ int_equal, int_neg }
import Test.Assert.{ Assert, execute_all_test }

let byte_to_int : (Byte) -> Int = builtin("%byte_to_int")

let int_to_byte : (Int) -> Byte = builtin("%int_to_byte")

let bytes_make : (Int, Byte) -> Bytes = builtin("%bytes_make")

let bytes_length : (Bytes) -> Int = builtin("%bytes_length")

let bytes_get : (Bytes, Int) -> Byte = builtin("%bytes_get")

let bytes_set : (Bytes, Int, Byte) -> Bytes = builtin("%bytes_set")

fn[T] identity(value : T) -> T {
  value
}

fn test_byte_and_bytes_primitives() -> Unit ! Assert {
  let fill = identity(int_to_byte(255))
  let original = identity(bytes_make(3, fill))
  let updated = bytes_set(original, 1, int_to_byte(0))
  assert_true!(int_equal(byte_to_int(int_to_byte(511)), 255))
  assert_true!(int_equal(byte_to_int(int_to_byte(int_neg(1))), 255))
  assert_true!(int_equal(bytes_length(original), 3))
  assert_true!(int_equal(byte_to_int(bytes_get(original, 0)), 255))
  assert_true!(int_equal(byte_to_int(bytes_get(original, 1)), 255))
  assert_true!(int_equal(byte_to_int(bytes_get(original, 2)), 255))
  assert_true!(int_equal(bytes_length(updated), 3))
  assert_true!(int_equal(byte_to_int(bytes_get(updated, 0)), 255))
  assert_true!(int_equal(byte_to_int(bytes_get(updated, 1)), 0))
  assert_true!(int_equal(byte_to_int(bytes_get(updated, 2)), 255))
}

pub fn answer() -> Unit ! Io {
  test_byte_and_bytes_primitives
    |> execute_all_test()
}
