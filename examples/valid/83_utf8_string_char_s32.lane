module Examples.Valid.Utf8StringCharS32

import Basic.Data.Bytes as ByteSeq
import Basic.Data.Char as Char
import Basic.Data.Option.{ Option }
import Basic.Data.S32 as S32
import Basic.Data.String as String
import Basic.Data.Int.{ int_impl_equal }
import Basic.Eff.Bound.{ OutOfBound }
import Test.Assert.{ Assert, execute_all_test }

fn assert_in_bounds(action : () -> Unit ! { OutOfBound, Assert }) -> Unit ! Assert {
  handle action() with {
    out_of_min[R](_resume) => assert_true!(false)
    out_of_max[R](_resume) => assert_true!(false)
  } final _value {
    ()
  }
}

fn char_equal(left : Char, right : Char) -> Bool {
  let equal = Char.char_impl_equal
  equal.equal(left, right)
}

fn string_equal(left : String, right : String) -> Bool {
  let equal = String.string_impl_equal
  equal.equal(left, right)
}

fn assert_some_char(value : Option[Char], expected : Char) -> Unit ! Assert {
  match value {
    some(actual) => assert_true!(char_equal(actual, expected))
    none() => assert_true!(false)
  }
}

fn assert_some_string(value : Option[String], expected : String) -> Unit ! Assert {
  match value {
    some(actual) => assert_true!(string_equal(actual, expected))
    none() => assert_true!(false)
  }
}

fn[T] is_none(value : Option[T]) -> Bool {
  match value {
    some(_) => false
    none() => true
  }
}

fn test_utf8_string_char_s32() -> Unit ! Assert {
  let text = "Aé中😀\0"
  let encoded = String.encode_utf8(text)
  let maximum : S32 = 2147483647
  let one : S32 = 1
  let add = S32.s32_impl_add
  let minimum = add.add(maximum, one)
  assert_eq!(String.byte_length(text), 11, int_impl_equal)
  assert_eq!(String.scalar_count(text), 5, int_impl_equal)
  assert_true!(ByteSeq.is_valid_utf8(encoded))
  assert_some_string(String.decode_utf8(encoded), text)
  assert_in_bounds(
    fn() {
      assert_true!(char_equal(String.scalar_at(text, 2), '中'))
      assert_true!(string_equal(String.slice(text, 1, 3), "é中😀"))
    }
  )
  let folded = String.foldl(
    text,
    "",
    fn(accumulator, scalar) {
      assert_true!(true)
      String.concat(accumulator, Char.to_string(scalar))
    }
  )
  assert_true!(string_equal(folded, text))
  assert_some_char(Char.from_int(128512), '😀')
  assert_true!(is_none(Char.from_int(55296)))
  assert_eq!(Char.to_int('😀'), 128512, int_impl_equal)
  assert_eq!(S32.to_int(minimum), S32.to_int(S32.from_int(2147483648)), int_impl_equal)
}

pub fn answer() -> Unit ! Io {
  test_utf8_string_char_s32
    |> execute_all_test()
}
