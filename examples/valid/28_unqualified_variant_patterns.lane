module Examples.Valid.UnqualifiedVariantPatterns

import Basic.Ops.*
import Basic.Data.I64.*
import Basic.Data.Bool.*
import Basic.Io.{ println }

enum Left {
  same(I64)
}

enum Right {
  same(Bool)
}

fn read_left(value : Left) -> I64 {
  match value {
    same(x) => x
  }
}

fn read_right(value : Right) -> I64 {
  match value {
    same(_) => 1
  }
}

pub let left_payload : I64 = read_left(Left::same(42))

pub fn answer() -> Unit ! Io {
  if left_payload == 42 && read_right(Right::same(true)) == 1 {
    println("left=42 right=1")
  } else {
    println("bad:left=42 right=1")
  }
}
