import {
  "moonbitlang/async@0.20.5",
  "moonbitlang/async@0.20.5/process",
  "moonbitlang/async@0.20.5/io",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.4.49/fs",
  "moonbitlang/x@0.4.49/sys",
}

priv suberror FixtureRunFailure {
  FixtureRunFailure(String)
} derive(Debug)

struct FixtureManifest {
  cases : Array[FixtureCase]
}

let fixture_timeout_ms : Int = 60000

enum FixtureCase {
  CheckSuccessCase(name~ : String, file~ : String)
  CheckErrorCase(
    name~ : String,
    file~ : String,
    expectation~ : FixtureExpectation
  )
  RunCase(
    name~ : String,
    file~ : String,
    entry~ : String,
    expectation~ : FixtureExpectation
  )
  RunErrorCase(
    name~ : String,
    file~ : String,
    entry~ : String,
    exit_code~ : Int,
    expectation~ : FixtureExpectation
  )
}

struct LaneRunResult {
  code : Int
  output : String
}

enum FixtureExpectation {
  Equals(String)
  Contains(Array[String], DiagnosticCounts?)
}

struct DiagnosticCounts {
  errors : Int
  warnings : Int
}

enum FixtureMode {
  CheckSuccess
  CheckError
  RunEntry
  RunError
} derive(Eq)

async fn main raise {
  require_basic_library()
  let manifest = read_fixture_manifest("examples/fixtures/lane-run.json")
  validate_corpus_coverage(manifest)
  let mut failure_count = 0
  for case in manifest.cases {
    let result = @async.with_timeout_opt(
      fixture_timeout_ms,
      () => run_lane(case),
    )
    guard result is Some(result) else {
      failure_count += 1
      println("FAILED " + case.name())
      println("  file: " + case.file())
      case.print_entry()
      println("  error: timed out after " + fixture_timeout_ms.to_string() + "ms")
      continue
    }
    if !matches_case_result(case, result) {
      failure_count += 1
      println("FAILED " + case.name())
      println("  file: " + case.file())
      case.print_entry()
      println("  exit: " + result.code.to_string())
      println("  actual: " + result.output)
      case.print_expectation()
    }
  }
  let explore_result = @async.with_timeout_opt(
    fixture_timeout_ms,
    () => run_explore_smoke(manifest.cases),
  )
  match explore_result {
    None => {
      failure_count += 1
      println("FAILED lane explore smoke")
      println(
        "  error: timed out after " + fixture_timeout_ms.to_string() + "ms",
      )
    }
    Some(result) if result.code != 0 => {
      failure_count += 1
      println("FAILED lane explore smoke")
      println("  actual: " + result.output)
    }
    Some(_) => ()
  }
  let separate_result = @async.with_timeout_opt(
    fixture_timeout_ms,
    run_separate_compile_smoke,
  )
  match separate_result {
    None => {
      failure_count += 1
      println("FAILED separate module artifact compile/link")
      println(
        "  error: timed out after " + fixture_timeout_ms.to_string() + "ms",
      )
    }
    Some(separate_result) => {
      let separate_expectation = Equals("")
      if separate_result.code != 0 ||
        !matches_expectation(separate_result.output, separate_expectation) {
        failure_count += 1
        println("FAILED separate module artifact compile/link")
        println("  exit: " + separate_result.code.to_string())
        println("  actual: " + separate_result.output)
        print_expectation(separate_expectation)
      }
    }
  }
  if failure_count != 0 {
    raise FixtureRunFailure(
      "lane run fixture failures: " + failure_count.to_string(),
    )
  }
}

async fn run_explore_smoke(cases : Array[FixtureCase]) -> LaneRunResult {
  for case in cases {
    guard case is RunCase(file~, entry~, ..) else { continue }
    let output_path = "_build/lane-explore-smoke.html"
    let result = run_moon_lane([
      "explore", file + ":" + entry, "--output", output_path,
    ])
    if result.code != 0 {
      return result
    }
    if !@fs.path_exists(output_path) {
      return { code: 1, output: "lane explore did not create " + output_path }
    }
    return { code: 0, output: "" }
  }
  { code: 1, output: "fixture manifest contains no executable example" }
}

fn read_fixture_manifest(path : String) -> FixtureManifest raise {
  decode_manifest(@json.parse(read_text(path)))
}

fn read_text(path : String) -> String raise {
  @fs.read_file_to_string(path, encoding="utf8")
}

fn decode_manifest(json : Json) -> FixtureManifest {
  match json {
    { "cases": Array(cases), .. } =>
      {
        cases: cases.mapi(fn(index, item) {
          decode_case(item, "cases[" + index.to_string() + "]")
        }),
      }
    _ => abort("manifest must contain array field cases")
  }
}

fn require_basic_library() -> Unit {
  match @env.get_env_var("LANE_HOME") {
    Some(home) => {
      let home = home.trim().to_owned()
      if home == "" {
        return fail_missing_basic(
          "LANE_HOME is set but empty.",
        )
      }
      let path = home + "/basic"
      if !@fs.path_exists(path) {
        return fail_missing_basic(
          "LANE_HOME/basic does not exist: " + path,
        )
      }
      if !(@fs.is_dir(path) catch { _ => false }) {
        return fail_missing_basic(
          "LANE_HOME/basic must be the Basic source directory: " + path,
        )
      }
      ()
    }
    None => fail_missing_basic("LANE_HOME is not set.")
  }
}

fn fail_missing_basic(reason : String) -> Unit {
  println("FAILED lane example fixture setup")
  println("  reason: " + reason)
  println("  Lane examples need the Basic library at LANE_HOME/basic.")
  println("  Initialize the pinned fixture, build Lane, and run the examples:")
  println("    git submodule update --init --checkout basic")
  println("    moon build --target native --release modules/lane")
  println(
    "    tools/check-lane-run-examples.sh " +
    "\"$PWD/_build/native/release/build/Milky2018/lane/lane.exe\"",
  )
  @sys.exit(1)
}

fn decode_case(json : Json, path : String) -> FixtureCase {
  match json {
    {
      "name": String(name),
      "file": String(file),
      ..
    } =>
      match decode_mode(json, path + ".mode") {
        CheckSuccess => {
          reject_entry_field(json, path)
          reject_exit_field(json, path)
          reject_expect_field(json, path)
          CheckSuccessCase(name~, file~)
        }
        CheckError => {
          reject_entry_field(json, path)
          reject_exit_field(json, path)
          let expectation = decode_required_expectation(json, path)
          CheckErrorCase(name~, file~, expectation~)
        }
        RunEntry => {
          reject_exit_field(json, path)
          let entry = decode_required_entry(json, path)
          let expectation = decode_required_expectation(json, path)
          RunCase(name~, file~, entry~, expectation~)
        }
        RunError => {
          let entry = decode_required_entry(json, path)
          let exit_code = decode_required_exit_code(json, path)
          let expectation = decode_required_expectation(json, path)
          RunErrorCase(name~, file~, entry~, exit_code~, expectation~)
        }
      }
    _ =>
      abort(
        path +
        " must contain string fields name/file and string field mode",
      )
  }
}

fn decode_mode(json : Json, path : String) -> FixtureMode {
  match json {
    { "mode": String(mode), .. } =>
      match mode {
        "check" => CheckSuccess
        "check-error" => CheckError
        "run" => RunEntry
        "run-error" => RunError
        _ =>
          abort(
            path +
            " must be \"check\", \"check-error\", \"run\", or \"run-error\"",
          )
      }
    _ => abort(path + " is required")
  }
}

fn reject_entry_field(json : Json, path : String) -> Unit {
  if json is { "entry": _, .. } {
    abort(path + ".entry is only valid for run cases")
  }
}

fn reject_exit_field(json : Json, path : String) -> Unit {
  if json is { "exit": _, .. } {
    abort(path + ".exit is only valid for run-error cases")
  }
}

fn reject_expect_field(json : Json, path : String) -> Unit {
  if json is { "expect": _, .. } {
    abort(path + ".expect is only valid for check-error and run cases")
  }
}

fn decode_required_entry(json : Json, path : String) -> String {
  match json {
    { "entry": String(entry), .. } => entry
    { "entry": _, .. } => abort(path + ".entry must be a JSON string")
    _ => abort(path + ".entry is required for run cases")
  }
}

fn decode_required_exit_code(json : Json, path : String) -> Int {
  match json {
    { "exit": Number(exit_code, ..), .. } => {
      let exit_code = exit_code.to_int()
      if exit_code == 0 {
        abort(path + ".exit must be nonzero for run-error cases")
      }
      exit_code
    }
    { "exit": _, .. } => abort(path + ".exit must be a JSON integer")
    _ => abort(path + ".exit is required for run-error cases")
  }
}

fn decode_required_expectation(
  json : Json,
  path : String
) -> FixtureExpectation {
  match json {
    { "expect": expectation, .. } =>
      decode_expectation(expectation, path + ".expect")
    _ => abort(path + ".expect is required")
  }
}

fn decode_expectation(json : Json, path : String) -> FixtureExpectation {
  match json {
    { "equals": String(_), "contains": _, .. } =>
      abort(path + " must contain exactly one of equals or contains")
    { "equals": String(expected), .. } => Equals(expected)
    { "contains": Array(items), .. } =>
      Contains(
        items.mapi(fn(index, item) {
          decode_string(item, path + ".contains[" + index.to_string() + "]")
        }),
        decode_diagnostic_counts(json, path),
      )
    _ => abort(path + " must contain exactly one of equals or contains")
  }
}

fn decode_diagnostic_counts(json : Json, path : String) -> DiagnosticCounts? {
  match json {
    { "diagnostics": { "errors": Number(errors, ..), "warnings": Number(warnings, ..), .. }, .. } => {
      let errors = errors.to_int()
      let warnings = warnings.to_int()
      if errors < 0 || warnings < 0 {
        abort(path + ".diagnostics counts must be non-negative")
      }
      Some({ errors, warnings })
    }
    { "diagnostics": _, .. } =>
      abort(path + ".diagnostics must contain integer errors and warnings")
    _ => None
  }
}

fn decode_string(json : Json, path : String) -> String {
  match json {
    String(value) => value
    _ => abort(path + " must be a JSON string")
  }
}

async fn run_lane(case : FixtureCase) -> LaneRunResult {
  let file = case.file()
  ignore(read_text(file))
  let fmt_args = ["fmt", "--check", file]
  let (fmt_code, fmt_output) = run_lane_process(fmt_args)
  let fmt_output = fmt_output.text().trim_end(chars="\n\r").to_owned()
  if fmt_code != 0 {
    return { code: fmt_code, output: fmt_output }
  }
  if !fmt_output.is_empty() {
    return { code: 0, output: fmt_output }
  }
  let check_args = [
    "check", "--deny", file,
  ]
  let (check_code, check_output) = run_lane_process(check_args)
  let check_output = check_output.text().trim_end(chars="\n\r").to_owned()
  if check_code != 0 {
    return { code: check_code, output: check_output }
  }
  if !check_output.is_empty() {
    return { code: 0, output: check_output }
  }
  match case {
    CheckSuccessCase(..) | CheckErrorCase(..) =>
      return { code: check_code, output: check_output }
    RunCase(entry~, ..) | RunErrorCase(entry~, ..) => {
      let args = ["run", file + ":" + entry]
      let (code, output) = run_lane_process(args)
      return { code, output: output.text().trim_end(chars="\n\r").to_owned() }
    }
  }
}

fn FixtureCase::name(self : FixtureCase) -> String {
  match self {
    CheckSuccessCase(name~, ..) => name
    CheckErrorCase(name~, ..) => name
    RunCase(name~, ..) => name
    RunErrorCase(name~, ..) => name
  }
}

fn FixtureCase::file(self : FixtureCase) -> String {
  match self {
    CheckSuccessCase(file~, ..) => file
    CheckErrorCase(file~, ..) => file
    RunCase(file~, ..) => file
    RunErrorCase(file~, ..) => file
  }
}

fn FixtureCase::print_entry(self : FixtureCase) -> Unit {
  match self {
    RunCase(entry~, ..) | RunErrorCase(entry~, ..) =>
      println("  entry: " + entry)
    _ => ()
  }
}

fn FixtureCase::print_expectation(self : FixtureCase) -> Unit {
  match self {
    CheckSuccessCase(..) => println("  expected: successful format and check")
    CheckErrorCase(expectation~, ..) => print_expectation(expectation)
    RunCase(expectation~, ..) => print_expectation(expectation)
    RunErrorCase(exit_code~, expectation~, ..) => {
      println("  expected exit: " + exit_code.to_string())
      print_expectation(expectation)
    }
  }
}

fn FixtureCase::matches_result(
  self : FixtureCase,
  result : LaneRunResult
) -> Bool {
  match self {
    CheckSuccessCase(..) => result.code == 0 && result.output == ""
    CheckErrorCase(expectation~, ..) =>
      result.code != 0 && matches_expectation(result.output, expectation)
    RunCase(expectation~, ..) =>
      result.code == 0 && matches_expectation(result.output, expectation)
    RunErrorCase(exit_code~, expectation~, ..) =>
      result.code == exit_code && matches_expectation(result.output, expectation)
  }
}

async fn run_separate_compile_smoke() -> LaneRunResult {
  let workspace = "_build/lane-separate-smoke"
  if !@fs.path_exists(workspace) {
    @fs.create_dir(workspace)
  }
  let fixture = "examples/projects/separate"
  let provider_path = fixture + "/Provider.lane"
  let unused_path = fixture + "/Unused.lane"
  let facade_path = fixture + "/Facade.lane"
  let main_path = fixture + "/Main.lane"
  let provider_interface = workspace + "/provider.lmi"
  let provider_object = workspace + "/provider.lmo"
  let unused_interface = workspace + "/unused.lmi"
  let unused_object = workspace + "/unused.lmo"
  let facade_interface = workspace + "/facade.lmi"
  let facade_object = workspace + "/facade.lmo"
  let main_interface = workspace + "/main.lmi"
  let main_object = workspace + "/main.lmo"
  let wasm = workspace + "/program.wasm"
  let provider_compile = run_moon_lane([
    "compile", provider_path, "-I", provider_interface, "-o", provider_object,
  ])
  if provider_compile.code != 0 {
    return provider_compile
  }
  let unused_compile = run_moon_lane([
    "compile", unused_path, "-I", unused_interface, "-o", unused_object,
  ])
  if unused_compile.code != 0 {
    return unused_compile
  }
  let facade_compile = run_moon_lane([
    "compile", facade_path, "--interface", provider_interface, "-I",
    facade_interface, "-o", facade_object,
  ])
  if facade_compile.code != 0 {
    return facade_compile
  }
  let main_check = run_moon_lane([
    "check", "--deny", main_path, "--lib", facade_path, "--lib", provider_path,
  ])
  if main_check.code != 0 {
    return main_check
  }
  let main_compile = run_moon_lane([
    "compile", main_path, "--interface", facade_interface, "--interface",
    provider_interface, "-I", main_interface, "-o", main_object,
  ])
  if main_compile.code != 0 {
    return main_compile
  }
  let link = run_moon_lane([
    "link", "--entry", "Examples.Projects.Separate.Main.main", "--output", wasm,
    main_object, facade_object, provider_object,
  ])
  if link.code != 0 {
    return link
  }
  run_moon_lane(["exec", wasm])
}

async fn run_moon_lane(lane_args : Array[String]) -> LaneRunResult {
  let (code, output) = run_lane_process(lane_args)
  { code, output: output.text().trim_end(chars="\n\r").to_owned() }
}

async fn run_lane_process(
  lane_args : Array[String],
) -> (Int, &@io.Data) {
  guard @env.get_env_var("LANE_SMOKE_BIN") is Some(lane_bin) else {
    abort("LANE_SMOKE_BIN is not set")
  }
  let args = []
  for arg in lane_args {
    args.push(arg)
  }
  @process.collect_output_merged(lane_bin, args)
}

fn matches_expectation(output : String, expectation : FixtureExpectation) -> Bool {
  match expectation {
    Equals(expected) => output == expected
    Contains(fragments, counts) => {
      for fragment in fragments {
        if !output.contains(fragment) {
          return false
        }
      }
      match counts {
        None => true
        Some(counts) =>
          diagnostic_count(output, "error[") == counts.errors &&
          diagnostic_count(output, "warning[") == counts.warnings
      }
    }
  }
}

fn diagnostic_count(output : String, prefix : String) -> Int {
  let mut count = 0
  for line in output.split("\n") {
    if line.has_prefix(prefix) {
      count += 1
    }
  }
  count
}

fn matches_case_result(case : FixtureCase, result : LaneRunResult) -> Bool {
  case.matches_result(result)
}

fn print_expectation(expectation : FixtureExpectation) -> Unit {
  match expectation {
    Equals(expected) => println("  expected: " + expected)
    Contains(fragments, counts) => {
      for fragment in fragments {
        println("  expected fragment: " + fragment)
      }
      if counts is Some(counts) {
        println("  expected errors: " + counts.errors.to_string())
        println("  expected warnings: " + counts.warnings.to_string())
      }
    }
  }
}

fn validate_corpus_coverage(manifest : FixtureManifest) -> Unit raise {
  let registered = manifest.cases.map(FixtureCase::file)
  validate_directory_coverage("examples/valid", registered)
  validate_directory_coverage("examples/invalid", registered)
  validate_directory_coverage("examples/warnings", registered)
  validate_directory_coverage("examples/runtime", registered)
}

fn validate_directory_coverage(
  directory : String,
  registered : Array[String],
) -> Unit raise {
  for entry in @fs.read_dir(directory) {
    if !entry.has_suffix(".lane") {
      continue
    }
    let file = directory + "/" + entry
    if !registered.contains(file) {
      raise FixtureRunFailure("example is missing from fixture manifest: " + file)
    }
  }
}
