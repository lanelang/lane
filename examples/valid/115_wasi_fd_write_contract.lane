module Examples.Valid115

import Basic.Builtins.{ bytes_length, i64_add, i64_to_i32, string_to_bytes }
import Basic.Wasm.Abi.{ WasmAddress, address, allocate, write_address, write_bytes, write_i32 }

// Guest addresses retain their backing byte buffer while the raw host call runs.
pub let fd_write : (I32, WasmAddress, I32, WasmAddress) -> I32 ! Io =
  extern("wasi_snapshot_preview1", "fd_write")

pub fn answer() -> Unit ! Io {
  let bytes = string_to_bytes("canonical wasi fd_write contract\n")
  let length = bytes_length(bytes)
  let frame = allocate(i64_add(12, length))
  write_bytes(frame, 12, bytes)
  write_address(frame, 0, frame, 12i32)
  write_i32(frame, 4, i64_to_i32(length))
  write_i32(frame, 8, 0i32)
  let _errno = fd_write(1i32, address(frame, 0i32), 1i32, address(frame, 8i32))
  ()
}
