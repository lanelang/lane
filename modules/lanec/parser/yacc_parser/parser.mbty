%derive<Debug> Token
%derive<Eq> TokenKind
%derive<Hash> TokenKind
%derive<Compare> TokenKind
%position<SourceSpan>
%derive<Debug> ParseError

%start source_file

%token<NumericLiteralToken> INT
%token<NumericLiteralToken> DOUBLE
%token<String> STRING
%token<Int> CHAR
%token<String> IDENT
%token<String> RESERVED
%token EOF
%token FALSE "false"
%token TRUE "true"
%token STRUCT "struct"
%token ENUM "enum"
%token EFFECT "effect"
%token FN "fn"
%token LET "let"
%token TYPE "type"
%token KIND_TYPE "Type"
%token KIND_EFFECT "Effect"
%token OFFER "offer"
%token AUTO "auto"
%token IF "if"
%token ELSE "else"
%token MATCH "match"
%token HANDLE "handle"
%token WITH "with"
%token FINAL "final"
%token DERIVE "derive"
%token BUILTIN "builtin"
%token EXTERN "extern"
%token MODULE "module"
%token IMPORT "import"
%token AS "as"
%token PUB "pub"
%token PLUS "+"
%token MINUS "-"
%token STAR "*"
%token SLASH "/"
%token PERCENT "%"
%token EQEQ "=="
%token BANGEQ "!="
%token LT "<"
%token LTEQ "<="
%token GT ">"
%token GTEQ ">="
%token AMPAMP "&&"
%token BARBAR "||"
%token BANG "!"
%token PIPE "|>"
%token LPAREN "("
%token RPAREN ")"
%token LBRACE "{"
%token RBRACE "}"
%token LBRACKET "["
%token OWNER_LBRACKET "owner ["
%token RBRACKET "]"
%token EMPTY_GENERIC_ARGUMENT_LIST_ERROR
%token EMPTY_TYPE_PARAMETER_LIST_ERROR
%token TYPE_IDENTIFIER_SLOT
%token EFFECT_IDENTIFIER_SLOT
%token VALUE_IDENTIFIER_SLOT
%token PATTERN_IDENTIFIER_SLOT
%token MISSING_TUPLE_TYPE_ITEM_ERROR
%token MISSING_TUPLE_EXPRESSION_ITEM_ERROR
%token MISSING_TUPLE_PATTERN_ITEM_ERROR
%token COMMA ","
%token SEMICOLON ";"
%token<LayoutNewlineClaim> LAYOUT_NEWLINE
%token DOTSTAR ".*"
%token DOTLBRACE ".{"
%token DOT "."
%token COLON ":"
%token COLONCOLON "::"
%token TIGHT_COLONCOLON "tight ::"
%token THIN_ARROW "->"
%token FAT_ARROW "=>"
%token EQUAL "="
%token UNDERSCORE "_"

%nonassoc PATTERN_BINDING
%nonassoc LAYOUT_NEWLINE
%left "|>"
%left "||"
%left "&&"
%left "==" "!="
%left "<" "<=" ">" ">="
%left "+" "-"
%left "*" "/" "%"
%left VARIANT_EXPR
%right "!" UNARY
%left PAREN_TYPE
%right "->"
%left "." "(" "[" "owner [" "::" "tight ::"

%%

source_file -> SourceFile
  : module_declaration layout_semicolons import_declarations top_level_declarations EOF {
    { module_path: $1, imports: $3, declarations: $4, loc: span($sloc) }
  }
  ;

layout_semicolons -> Unit
  : { () }
  | layout_semicolons LAYOUT_NEWLINE { claim_layout_separator($2) }
  ;

item_semicolon -> Unit
  : ";" { () }
  | LAYOUT_NEWLINE { claim_layout_separator($1) }
  ;

layout_list_separator -> Unit
  : "," { () }
  | LAYOUT_NEWLINE { claim_layout_separator($1) }
  ;

layout_continuation_opt -> Unit
  : { () }
  | LAYOUT_NEWLINE { () }
  ;

module_declaration -> ModulePath
  : "module" module_path { $2 }
  ;

module_path -> ModulePath
  : non_empty_module_path { { components: $1, loc: span($sloc) } }
  ;

non_empty_module_path -> Array[String]
  : IDENT { [ $1 ] }
  | non_empty_module_path "." IDENT { comma_push($1, $3) }
  ;

import_declarations -> Array[ImportDeclaration]
  : { [] }
  | import_declarations import_declaration layout_semicolons { comma_push($1, $2) }
  ;

import_declaration -> ImportDeclaration
  : "import" module_path {
    Qualified(module_path=$2, module_alias=None, loc=span($sloc))
  }
  | "import" module_path module_alias {
    Qualified(module_path=$2, module_alias=Some($3), loc=span($sloc))
  }
  | "import" module_path ".*" {
    Open(module_path=$2, loc=span($sloc))
  }
  | "import" module_path ".{" import_item_list "}" {
    Selective(module_path=$2, items=$4, loc=span($sloc))
  }
  ;

module_alias -> ModuleAlias
  : "as" identifier {
    { name: $2.name, name_loc: $2.loc, loc: span($sloc) }
  }
  ;

import_item_list -> Array[ImportItem]
  : { [] }
  | non_empty_import_item_list { $1 }
  ;

non_empty_import_item_list -> Array[ImportItem]
  : import_item { [ $1 ] }
  | non_empty_import_item_list layout_list_separator import_item { comma_push($1, $3) }
  | non_empty_import_item_list layout_list_separator { $1 }
  ;

import_item -> ImportItem
  : IDENT { { name: $1, loc: span($sloc) } }
  ;

identifier -> Identifier
  : IDENT { { name: $1, loc: span($sloc) } }
  ;

top_level_declarations -> Array[TopLevelDeclaration]
  : { [] }
  | top_level_declarations top_level_declaration layout_semicolons { comma_push($1, $2) }
  ;

top_level_declaration -> TopLevelDeclaration
  : struct_declaration { Struct($1) }
  | enum_declaration { Enum($1) }
  | effect_declaration { Effect($1) }
  | external_type_declaration { ExternalType($1) }
  | type_alias_declaration { TypeAlias($1) }
  | function_declaration { Function($1) }
  | top_level_let_declaration { Let($1) }
  | offer_value_declaration { Let($1) }
  | "pub" public_top_level_declaration { with_public_loc($2, span($sloc)) }
  ;

public_top_level_declaration -> TopLevelDeclaration
  : public_struct_declaration { Struct($1) }
  | public_enum_declaration { Enum($1) }
  | public_effect_declaration { Effect($1) }
  | public_external_type_declaration { ExternalType($1) }
  | public_type_alias_declaration { TypeAlias($1) }
  | public_function_declaration { Function($1) }
  | public_top_level_let_declaration { Let($1) }
  | public_offer_value_declaration { Let($1) }
  ;

external_type_declaration -> ExternalTypeDeclaration
  : "extern" "type" identifier type_parameters ":" external_type_result_kind { make_external_type(false, $3, $4, $6, span($sloc)) }
  ;

public_external_type_declaration -> ExternalTypeDeclaration
  : "extern" "type" identifier type_parameters ":" external_type_result_kind { make_external_type(true, $3, $4, $6, span($sloc)) }
  ;

external_type_result_kind -> ExternalTypeKind
  : "Type" { Type(loc=span($sloc)) }
  | "Effect" { Effect(loc=span($sloc)) }
  ;

type_alias_declaration -> TypeAliasDeclaration
  : "type" identifier type_parameters type_alias_result_kind_opt "=" type_alias_body {
    { is_public: false, name: $2.name, name_loc: $2.loc, type_parameters: $3, result_kind: $4, body: $6, loc: span($sloc) }
  }
  ;

public_type_alias_declaration -> TypeAliasDeclaration
  : "type" identifier type_parameters type_alias_result_kind_opt "=" type_alias_body {
    { is_public: true, name: $2.name, name_loc: $2.loc, type_parameters: $3, result_kind: $4, body: $6, loc: span($sloc) }
  }
  ;

type_alias_body -> TypeAliasBody
  : type { TypeBody($1) }
  | "{" type_list "}" {
    EffectBody(effect_set($2, span($sloc)))
  }
  ;

struct_declaration -> StructDeclaration
  : "struct" identifier nominal_body_open layout_semicolons struct_members "}" {
    { is_public: false, name: $2.name, name_loc: $2.loc, type_parameters: $3, members: $5, loc: span($sloc) }
  }
  ;

public_struct_declaration -> StructDeclaration
  : "struct" identifier nominal_body_open layout_semicolons struct_members "}" {
    { is_public: true, name: $2.name, name_loc: $2.loc, type_parameters: $3, members: $5, loc: span($sloc) }
  }
  ;

struct_members -> Array[StructMember]
  : { [] }
  | non_empty_struct_members { $1 }
  ;

non_empty_struct_members -> Array[StructMember]
  : struct_member { [ $1 ] }
  | non_empty_struct_members item_semicolon struct_member { comma_push($1, $3) }
  | non_empty_struct_members item_semicolon { $1 }
  ;

struct_member -> StructMember
  : type_member_declaration { TypeMember($1) }
  | field_declaration { Field($1) }
  ;

type_member_declaration -> TypeMemberDeclaration
  : "type" identifier {
    { name: $2.name, name_loc: $2.loc, kind: None, loc: span($sloc) }
  }
  | "type" identifier ":" kind {
    { name: $2.name, name_loc: $2.loc, kind: Some($4), loc: span($sloc) }
  }
  ;

kind -> Kind
  : "Type" { Type(loc=span($sloc)) }
  | "Effect" { Effect(loc=span($sloc)) }
  | "[" kind_list "]" "->" kind {
    Function(parameters=$2, result=$5, loc=span($sloc))
  }
  | "(" kind ")" { Grouped(kind=$2, loc=span($sloc)) }
  ;

kind_list -> Array[Kind]
  : { [] }
  | non_empty_kind_list { $1 }
  ;

non_empty_kind_list -> Array[Kind]
  : kind { [ $1 ] }
  | non_empty_kind_list "," kind { comma_push($1, $3) }
  | non_empty_kind_list "," { $1 }
  ;

field_declaration -> FieldDeclaration
  : identifier ":" type {
    { name: $1.name, name_loc: $1.loc, type_: $3, loc: span($sloc) }
  }
  ;

enum_declaration -> EnumDeclaration
  : "enum" identifier nominal_body_open layout_semicolons enum_variants "}" {
    { is_public: false, name: $2.name, name_loc: $2.loc, type_parameters: $3, variants: $5, loc: span($sloc) }
  }
  ;

public_enum_declaration -> EnumDeclaration
  : "enum" identifier nominal_body_open layout_semicolons enum_variants "}" {
    { is_public: true, name: $2.name, name_loc: $2.loc, type_parameters: $3, variants: $5, loc: span($sloc) }
  }
  ;

enum_variants -> Array[EnumVariant]
  : { [] }
  | non_empty_enum_variants { $1 }
  ;

non_empty_enum_variants -> Array[EnumVariant]
  : enum_variant { [ $1 ] }
  | non_empty_enum_variants item_semicolon enum_variant { comma_push($1, $3) }
  | non_empty_enum_variants item_semicolon { $1 }
  ;

enum_variant -> EnumVariant
  : identifier layout_continuation_opt "(" type_list ")" {
    { name: $1.name, name_loc: $1.loc, type_parameters: [], payload: $4, loc: span($sloc) }
  }
  | identifier layout_continuation_opt type_parameter_bracket_list layout_continuation_opt "(" type_list ")" {
    { name: $1.name, name_loc: $1.loc, type_parameters: $3, payload: $6, loc: span($sloc) }
  }
  ;

effect_declaration -> EffectDeclaration
  : "effect" identifier nominal_body_open layout_semicolons effect_operations "}" {
    { is_public: false, name: $2.name, name_loc: $2.loc, type_parameters: $3, operations: $5, loc: span($sloc) }
  }
  ;

public_effect_declaration -> EffectDeclaration
  : "effect" identifier nominal_body_open layout_semicolons effect_operations "}" {
    { is_public: true, name: $2.name, name_loc: $2.loc, type_parameters: $3, operations: $5, loc: span($sloc) }
  }
  ;

effect_operations -> Array[EffectOperationDeclaration]
  : { [] }
  | non_empty_effect_operations { $1 }
  ;

non_empty_effect_operations -> Array[EffectOperationDeclaration]
  : effect_operation { [ $1 ] }
  | non_empty_effect_operations item_semicolon effect_operation { comma_push($1, $3) }
  | non_empty_effect_operations item_semicolon { $1 }
  ;

effect_operation -> EffectOperationDeclaration
  : identifier layout_continuation_opt "(" type_list ")" "->" type {
    { name: $1.name, name_loc: $1.loc, type_parameters: [], payload: $4, result: $7, loc: span($sloc) }
  }
  | identifier layout_continuation_opt type_parameter_bracket_list layout_continuation_opt "(" type_list ")" "->" type {
    { name: $1.name, name_loc: $1.loc, type_parameters: $3, payload: $6, result: $9, loc: span($sloc) }
  }
  ;

function_declaration -> FunctionDeclaration
  : function_prefix type_parameters identifier parameters "->" type effect_annotation_opt layout_continuation_opt block_expression {
    {
      is_public: false,
      is_offered: $1,
      type_parameters: $2,
      name: $3.name,
      name_loc: $3.loc,
      parameters: $4,
      return_type: $6,
      effect: effect_or_empty($7, $6),
      body: $9,
      loc: span($sloc),
    }
  }
  ;

public_function_declaration -> FunctionDeclaration
  : function_prefix type_parameters identifier parameters "->" type effect_annotation_opt layout_continuation_opt block_expression {
    {
      is_public: true,
      is_offered: $1,
      type_parameters: $2,
      name: $3.name,
      name_loc: $3.loc,
      parameters: $4,
      return_type: $6,
      effect: effect_or_empty($7, $6),
      body: $9,
      loc: span($sloc),
    }
  }
  ;

%inline function_prefix -> Bool
  : "fn" { false }
  | "offer" "fn" { true }
  ;

parameters -> Array[Parameter]
  : layout_continuation_opt "(" ")" { [] }
  | layout_continuation_opt "(" non_empty_parameter_list ")" { $3 }
  ;

non_empty_parameter_list -> Array[Parameter]
  : parameter { [ $1 ] }
  | non_empty_parameter_list "," parameter { comma_push($1, $3) }
  ;

parameter -> Parameter
  : parameter_modifiers identifier ":" type {
    { is_auto: $1.is_auto, is_offered: $1.is_offered, name: $2.name, name_loc: $2.loc, type_: $4, loc: span($sloc) }
  }
  ;

parameter_modifiers -> ParameterModifiers
  : { { is_auto: false, is_offered: false } }
  | "auto" { { is_auto: true, is_offered: false } }
  | "offer" { { is_auto: false, is_offered: true } }
  | "auto" "offer" { { is_auto: true, is_offered: true } }
  | "offer" "auto" { { is_auto: true, is_offered: true } }
  ;

top_level_let_declaration -> LetDeclaration
  : "let" identifier ":" type "=" expression {
    { is_public: false, is_offered: false, name: $2.name, name_loc: $2.loc, type_annotation: Some($4), initializer: $6, loc: span($sloc) }
  }
  ;

public_top_level_let_declaration -> LetDeclaration
  : "let" identifier ":" type "=" expression {
    { is_public: true, is_offered: false, name: $2.name, name_loc: $2.loc, type_annotation: Some($4), initializer: $6, loc: span($sloc) }
  }
  ;

local_let_item -> LocalItem
  : "let" pattern local_type_annotation "=" expression { local_let_item($2, $3, $5, span($sloc)) }
  ;

local_type_annotation -> Type?
  : { None }
  | ":" type { Some($2) }
  ;

offer_value_declaration -> LetDeclaration
  : "offer" identifier ":" type "=" expression {
    { is_public: false, is_offered: true, name: $2.name, name_loc: $2.loc, type_annotation: Some($4), initializer: $6, loc: span($sloc) }
  }
  ;

public_offer_value_declaration -> LetDeclaration
  : "offer" identifier ":" type "=" expression {
    { is_public: true, is_offered: true, name: $2.name, name_loc: $2.loc, type_annotation: Some($4), initializer: $6, loc: span($sloc) }
  }
  ;

type_parameters -> Array[TypeParameter]
  : { [] }
  | type_parameter_bracket_list { $1 }
  | LAYOUT_NEWLINE type_parameter_bracket_list { $2 }
  ;

nominal_body_open -> Array[TypeParameter]
  : "{" { [] }
  | LAYOUT_NEWLINE "{" { [] }
  | type_parameter_bracket_list "{" { $1 }
  | type_parameter_bracket_list LAYOUT_NEWLINE "{" { $1 }
  | LAYOUT_NEWLINE type_parameter_bracket_list "{" { $2 }
  | LAYOUT_NEWLINE type_parameter_bracket_list LAYOUT_NEWLINE "{" { $2 }
  ;

type_parameter_bracket_list -> Array[TypeParameter]
  : "[" non_empty_type_parameter_list "]" { $2 }
  | "[" EMPTY_TYPE_PARAMETER_LIST_ERROR "]" { [] }
  ;

non_empty_type_parameter_list -> Array[TypeParameter]
  : type_parameter { [ $1 ] }
  | non_empty_type_parameter_list "," type_parameter { comma_push($1, $3) }
  | non_empty_type_parameter_list "," { $1 }
  ;

type_parameter -> TypeParameter
  : identifier {
    { name: $1.name, name_loc: $1.loc, kind: None, loc: span($sloc) }
  }
  | identifier ":" kind {
    { name: $1.name, name_loc: $1.loc, kind: Some($3), loc: span($sloc) }
  }
  ;

type -> Type
  : TYPE_IDENTIFIER_SLOT { abort("type completion slot token must not be shifted") }
  | type_lambda { $1 }
  | function_type { $1 }
  | type_application %prec PAREN_TYPE { $1 }
  ;

type_lambda -> Type
  : "type" type_parameter_bracket_list "=>" type {
    TypeLambda(parameters=$2, body=$4, loc=span($sloc))
  }
  ;

type_application -> Type
  : type_primary { $1 }
  | type_application "[" non_empty_generic_argument_list "]" {
    Apply(callee=$1, arguments=$3, loc=span($sloc))
  }
  | type_application "[" EMPTY_GENERIC_ARGUMENT_LIST_ERROR "]" {
    Apply(callee=$1, arguments=[], loc=span($sloc))
  }
  ;

type_primary -> Type
  : qualified_type_name { $1.to_type() }
  | IDENT {
    Name(name=$1, loc=span($sloc))
  }
  | "(" type "," tuple_type_tail ")" {
    Tuple(items=[$2] + $4, loc=span($sloc))
  }
  | "(" type ")" %prec PAREN_TYPE { Grouped(type_=$2, loc=span($sloc)) }
  ;

tuple_type_tail -> Array[Type]
  : MISSING_TUPLE_TYPE_ITEM_ERROR { abort("missing tuple type item token must not be shifted") }
  | type { [ $1 ] }
  | tuple_type_tail "," type { comma_push($1, $3) }
  ;

qualified_type_name -> NominalTypeName
  : IDENT "." IDENT {
    let loc = span($sloc)
    {
      module_path: Some({
        components: [ $1 ],
        loc: loc.ascii_prefix($1.length()),
      }),
      name: $3,
      loc,
    }
  }
  | qualified_type_name "." IDENT { $1.extended($3, span($sloc)) }
  ;

function_type -> Type
  : "(" ")" "->" type effect_annotation_opt {
    Function(type_parameters=[], parameters=[], result=$4, effect=effect_or_empty($5, $4), loc=span($sloc))
  }
  | "(" type ")" "->" type effect_annotation_opt {
    Function(type_parameters=[], parameters=[$2], result=$5, effect=effect_or_empty($6, $5), loc=span($sloc))
  }
  | "(" type "," tuple_type_tail ")" "->" type effect_annotation_opt {
    Function(type_parameters=[], parameters=[$2] + $4, result=$7, effect=effect_or_empty($8, $7), loc=span($sloc))
  }
  | type_parameter_bracket_list layout_continuation_opt "(" type_list ")" "->" type effect_annotation_opt {
    Function(type_parameters=$1, parameters=$4, result=$7, effect=effect_or_empty($8, $7), loc=span($sloc))
  }
  ;

effect_annotation_opt -> EffectTerm?
  : { None }
  | effect_annotation { Some($1) }
  ;

effect_annotation -> EffectTerm
  : "!" effect_set { $2 }
  ;

effect_set -> EffectTerm
  : EFFECT_IDENTIFIER_SLOT { abort("effect completion slot token must not be shifted") }
  | type_application { Term(type_=$1, loc=$1.loc()) }
  | "{" type_list "}" { effect_set($2, span($sloc)) }
  ;

type_list -> Array[Type]
  : { [] }
  | non_empty_type_list { $1 }
  ;

non_empty_type_list -> Array[Type]
  : type { [ $1 ] }
  | non_empty_type_list layout_list_separator type { comma_push($1, $3) }
  | non_empty_type_list layout_list_separator { $1 }
  ;

expression -> Expr
  : VALUE_IDENTIFIER_SLOT { abort("value completion slot token must not be shifted") }
  | expression "|>" expression {
    Pipeline(left=$1, right=$3, loc=span($sloc))
  }
  | expression "||" expression {
    Binary(operator=Or, left=$1, right=$3, loc=span($sloc))
  }
  | expression "&&" expression {
    Binary(operator=And, left=$1, right=$3, loc=span($sloc))
  }
  | expression "==" expression {
    Binary(operator=Equal, left=$1, right=$3, loc=span($sloc))
  }
  | expression "!=" expression {
    Binary(operator=NotEqual, left=$1, right=$3, loc=span($sloc))
  }
  | expression "<" expression {
    Binary(operator=Less, left=$1, right=$3, loc=span($sloc))
  }
  | expression "<=" expression {
    Binary(operator=LessEqual, left=$1, right=$3, loc=span($sloc))
  }
  | expression ">" expression {
    Binary(operator=Greater, left=$1, right=$3, loc=span($sloc))
  }
  | expression ">=" expression {
    Binary(operator=GreaterEqual, left=$1, right=$3, loc=span($sloc))
  }
  | expression "+" expression {
    Binary(operator=Add, left=$1, right=$3, loc=span($sloc))
  }
  | expression "-" expression {
    Binary(operator=Sub, left=$1, right=$3, loc=span($sloc))
  }
  | expression "*" expression {
    Binary(operator=Mul, left=$1, right=$3, loc=span($sloc))
  }
  | expression "/" expression {
    Binary(operator=Div, left=$1, right=$3, loc=span($sloc))
  }
  | expression "%" expression {
    Binary(operator=Rem, left=$1, right=$3, loc=span($sloc))
  }
  | unary_expression { $1 }
  ;

unary_expression -> Expr
  : "-" unary_expression %prec UNARY {
    negated_expression($2, span($sloc))
  }
  | "!" unary_expression %prec UNARY {
    Unary(operator=Not, operand=$2, loc=span($sloc))
  }
  | postfix_expression { $1 }
  ;

postfix_expression -> Expr
  : value_postfix_expression { $1 }
  ;

value_postfix_expression -> Expr
  : member_expression { $1 }
  | owner_expression { $1.expr }
  | non_owner_primary_expression { $1 }
  | value_postfix_expression "(" argument_list ")" { Call(callee=$1, arguments=$3, loc=span($sloc)) }
  | value_postfix_expression type_arguments %prec "[" { TypeApplication(callee=$1, arguments=$2, loc=span($sloc)) }
  | value_postfix_expression "." IDENT { Field(base=$1, name=$3, name_loc=span($sloc).ascii_suffix($3.length()), loc=span($sloc)) }
  | identifier "!" "(" positional_argument_list ")" { EffectOperationCall(name=Unqualified(operation=$1.name, operation_loc=$1.loc), type_witnesses=[], arguments=$4, loc=span($sloc)) }
  | identifier "!" operation_type_witnesses "(" positional_argument_list ")" { EffectOperationCall(name=Unqualified(operation=$1.name, operation_loc=$1.loc), type_witnesses=$3, arguments=$5, loc=span($sloc)) }
  ;

member_expression -> Expr
  : owner_expression "tight ::" identifier "!" "(" positional_argument_list ")" %prec "tight ::" {
    EffectOperationCall(
      name=Qualified(
        owner=$1.owner,
        operation=$3.name,
        operation_loc=$3.loc
      ),
      type_witnesses=[],
      arguments=$6,
      loc=span($sloc)
    )
  }
  | owner_expression "tight ::" identifier "!" operation_type_witnesses "(" positional_argument_list ")" %prec "tight ::" {
    EffectOperationCall(
      name=Qualified(
        owner=$1.owner,
        operation=$3.name,
        operation_loc=$3.loc
      ),
      type_witnesses=$5,
      arguments=$7,
      loc=span($sloc)
    )
  }
  | owner_expression "tight ::" "{" struct_literal_fields "}" %prec "tight ::" {
    StructLiteral(owner=$1.owner, fields=$4, loc=span($sloc))
  }
  | owner_expression "tight ::" IDENT variant_type_arguments variant_arguments %prec VARIANT_EXPR {
    QualifiedVariant(owner=$1.owner, variant=$3, variant_loc=$1.owner.loc().ascii_after(2, $3.length()), variant_type_arguments=$4, arguments=$5, loc=span($sloc))
  }
  ;

owner_path_expression -> OwnerPathExpression
  : IDENT { { expr: Var($1, loc=span($sloc)), owner: { module_path: None, name: $1, loc: span($sloc) } } }
  | owner_path_expression "." IDENT { owner_path_field($1, $3, span($sloc).ascii_suffix($3.length()), span($sloc)) }
  ;

owner_expression -> OwnerExpression
  : owner_path_expression { { expr: $1.expr, owner: $1.owner.to_type() } }
  | owner_path_expression owner_type_arguments %prec "owner [" { owner_expression_with_arguments($1, $2, span($sloc)) }
  ;

owner_type_arguments -> Array[GenericArgument]
  : "owner [" non_empty_generic_argument_list "]" { $2 }
  | "owner [" EMPTY_GENERIC_ARGUMENT_LIST_ERROR "]" { [] }
  ;

non_owner_primary_expression -> Expr
  : INT { integer_expression_literal($1, span($sloc)) }
  | DOUBLE { floating_expression_literal($1, span($sloc)) }
  | STRING { StringLiteral($1, loc=span($sloc)) }
  | CHAR { CharLiteral($1, loc=span($sloc)) }
  | "true" { BoolLiteral(true, loc=span($sloc)) }
  | "false" { BoolLiteral(false, loc=span($sloc)) }
  | "(" ")" { UnitLiteral(loc=span($sloc)) }
  | "(" expression "," tuple_expression_tail ")" {
    TupleLiteral(items=[$2] + $4, loc=span($sloc))
  }
  | "(" expression ")" { Grouped(expression=$2, loc=span($sloc)) }
  | block_expression { $1 }
  | if_expression { $1 }
  | match_expression { $1 }
  | handler_expression { $1 }
  | function_literal { $1 }
  | "[" list_literal_items "]" { ListLiteral(items=$2, loc=span($sloc)) }
  | derive_expression { $1 }
  | builtin_expression { $1 }
  | extern_expression { $1 }
  ;

list_literal_items -> Array[Expr]
  : { [] }
  | non_empty_positional_argument_list { $1 }
  ;

tuple_expression_tail -> Array[Expr]
  : MISSING_TUPLE_EXPRESSION_ITEM_ERROR { abort("missing tuple expression item token must not be shifted") }
  | expression { [ $1 ] }
  | tuple_expression_tail "," expression { comma_push($1, $3) }
  ;

derive_expression -> Expr
  : "derive" "[" derive_type_arguments "]" "(" argument_list ")" {
    Derive(
      capability=$3.capability,
      target=$3.target,
      arguments=$6,
      source=derive_source_site(span($sloc)),
    )
  }
  ;

derive_type_arguments -> DeriveTypeArguments
  : type layout_list_separator type {
    { capability: $1, target: $3 }
  }
  | type layout_list_separator type layout_list_separator {
    { capability: $1, target: $3 }
  }
  ;

operation_type_witnesses -> Array[GenericArgument]
  : type_arguments { $1 }
  ;

type_arguments -> Array[GenericArgument]
  : type_argument_bracket_list { $1 }
  ;

type_argument_bracket_list -> Array[GenericArgument]
  : "[" non_empty_generic_argument_list "]" { $2 }
  | "[" EMPTY_GENERIC_ARGUMENT_LIST_ERROR "]" { [] }
  ;

generic_argument -> GenericArgument
  : type { TypeTerm($1) }
  | "{" type_list "}" { EffectTerm(effect_set($2, span($sloc))) }
  ;

non_empty_generic_argument_list -> Array[GenericArgument]
  : generic_argument { [ $1 ] }
  | non_empty_generic_argument_list layout_list_separator generic_argument { comma_push($1, $3) }
  | non_empty_generic_argument_list layout_list_separator { $1 }
  ;

nominal_type_name -> Type
  : IDENT { Name(name=$1, loc=span($sloc)) }
  | qualified_type_name { $1.to_type() }
  ;

variant_type_arguments -> Array[GenericArgument]
  : %prec VARIANT_EXPR { [] }
  | type_arguments { $1 }
  ;

struct_literal_fields -> Array[StructLiteralField]
  : { [] }
  | non_empty_struct_literal_fields { $1 }
  ;

non_empty_struct_literal_fields -> Array[StructLiteralField]
  : struct_literal_field { [ $1 ] }
  | non_empty_struct_literal_fields layout_list_separator struct_literal_field { comma_push($1, $3) }
  | non_empty_struct_literal_fields layout_list_separator { $1 }
  ;

struct_literal_field -> StructLiteralField
  : IDENT { Value(name=$1, value=None, loc=span($sloc)) }
  | IDENT ":" expression { Value(name=$1, value=Some($3), loc=span($sloc)) }
  | IDENT "=" generic_argument { TypeWitness(name=$1, witness=$3, loc=span($sloc)) }
  ;

variant_arguments -> Array[Expr]
  : layout_continuation_opt "(" positional_argument_list ")" { $3 }
  ;

positional_argument_list -> Array[Expr]
  : { [] }
  | non_empty_positional_argument_list { $1 }
  ;

argument_list -> Array[CallArgument]
  : { [] }
  | non_empty_argument_list { $1 }
  ;

non_empty_argument_list -> Array[CallArgument]
  : call_argument { [ $1 ] }
  | non_empty_argument_list "," call_argument { comma_push($1, $3) }
  | non_empty_argument_list "," { $1 }
  ;

call_argument -> CallArgument
  : expression { Positional(value=$1, loc=span($sloc)) }
  | IDENT "=" expression { Named(name=$1, value=$3, loc=span($sloc)) }
  ;

non_empty_positional_argument_list -> Array[Expr]
  : expression { [ $1 ] }
  | non_empty_positional_argument_list "," expression { comma_push($1, $3) }
  | non_empty_positional_argument_list "," { $1 }
  ;

block_expression -> Expr
  : "{" layout_semicolons local_items expression "}" {
    Block(items=$3, result=$4, loc=span($sloc))
  }
  ;

local_items -> Array[LocalItem]
  : { [] }
  | local_items local_item item_semicolon { comma_push($1, $2) }
  ;

local_item -> LocalItem
  : local_let_item { $1 }
  | function_declaration { Function($1) }
  | offer_value_declaration { Let($1) }
  | expression { Expression(expression=$1) }
  ;

if_expression -> Expr
  : "if" expression layout_continuation_opt block_expression optional_else_branch {
    If(condition=$2, then_branch=$4, else_branch=$5, loc=span($sloc))
  }
  ;

optional_else_branch -> Expr?
  : { None }
  | "else" else_branch_expression { Some($2) }
  ;

else_branch_expression -> Expr
  : block_expression { $1 }
  | if_expression { $1 }
  ;

match_expression -> Expr
  : "match" expression layout_continuation_opt "{" layout_semicolons match_arms "}" {
    Match(scrutinee=$2, arms=$6, loc=span($sloc))
  }
  ;

match_arms -> Array[MatchArm]
  : { [] }
  | non_empty_match_arms { $1 }
  ;

non_empty_match_arms -> Array[MatchArm]
  : match_arm { [ $1 ] }
  | non_empty_match_arms item_semicolon match_arm { comma_push($1, $3) }
  | non_empty_match_arms item_semicolon { $1 }
  ;

match_arm -> MatchArm
  : pattern "=>" expression {
    { pattern: $1, body: $3, loc: span($sloc) }
  }
  ;

handler_expression -> Expr
  : "handle" expression handler_with_blocks handler_final_branch {
    Handler(body=$2, handlers=$3, final_branch=$4, loc=span($sloc))
  }
  ;

handler_with_blocks -> Array[HandlerWithBlock]
  : handler_with_block { [ $1 ] }
  | handler_with_blocks handler_with_block { comma_push($1, $2) }
  ;

handler_with_block -> HandlerWithBlock
  : "with" "{" layout_semicolons handler_operation_arms "}" {
    { arms: $4, loc: span($sloc) }
  }
  ;

handler_operation_arms -> Array[HandlerOperationArm]
  : non_empty_handler_operation_arms { $1 }
  ;

non_empty_handler_operation_arms -> Array[HandlerOperationArm]
  : handler_operation_arm { [ $1 ] }
  | non_empty_handler_operation_arms item_semicolon handler_operation_arm { comma_push($1, $3) }
  | non_empty_handler_operation_arms item_semicolon { $1 }
  ;

handler_operation_arm -> HandlerOperationArm
  : handler_operation_signature_open handler_operation_arm_parameters ")" "=>" expression {
    {
      name: $1.name,
      type_binders: $1.type_binders,
      payload_patterns: $2.payload_patterns,
      resume_binder: $2.resume_binder,
      resume_loc: $2.resume_loc,
      body: $5,
      loc: span($sloc)
    }
  }
  ;

handler_operation_name -> EffectOperationName
  : identifier { Unqualified(operation=$1.name, operation_loc=$1.loc) }
  | identifier "tight ::" identifier { qualified_handler_operation_name(Name(name=$1.name, loc=$1.loc), None, $3) }
  | identifier handler_operation_generic_arguments "tight ::" identifier { qualified_handler_operation_name(Name(name=$1.name, loc=$1.loc), Some($2), $4) }
  | qualified_type_name handler_operation_owner_arguments "tight ::" identifier { qualified_handler_operation_name($1.to_type(), $2, $4) }
  ;

handler_operation_signature_open -> HandlerOperationHead
  : handler_operation_name "(" { { name: $1, type_binders: [] } }
  | handler_operation_name ident_bracket_list "(" {
    { name: $1, type_binders: $2 }
  }
  | handler_operation_name ident_bracket_list LAYOUT_NEWLINE "(" {
    { name: $1, type_binders: $2 }
  }
  | handler_operation_name LAYOUT_NEWLINE handler_operation_signature_after_newline {
    { name: $1, type_binders: $3 }
  }
  ;

handler_operation_signature_after_newline -> Array[TypeBinder]
  : "(" { [] }
  | ident_bracket_list "(" { $1 }
  | ident_bracket_list LAYOUT_NEWLINE "(" { $1 }
  ;

ident_bracket_list -> Array[TypeBinder]
  : "[" non_empty_ident_list "]" { $2 }
  | "[" EMPTY_TYPE_PARAMETER_LIST_ERROR "]" { [] }
  ;

handler_operation_owner_arguments -> GenericArgumentList?
  : { None }
  | handler_operation_generic_arguments { Some($1) }
  ;

handler_operation_generic_arguments -> GenericArgumentList
  : "owner [" non_empty_generic_argument_list "]" { { arguments: $2, loc: span($sloc) } }
  ;

handler_operation_arm_parameters -> HandlerOperationArmParameters
  : identifier { { payload_patterns: [], resume_binder: $1.name, resume_loc: $1.loc } }
  | handler_payload_patterns "," identifier { { payload_patterns: $1, resume_binder: $3.name, resume_loc: $3.loc } }
  ;

handler_payload_patterns -> Array[Pattern]
  : pattern { [ $1 ] }
  | handler_payload_patterns "," pattern { comma_push($1, $3) }
  ;

handler_final_branch -> HandlerFinalBranch
  : "final" identifier layout_continuation_opt block_expression { { binder: $2.name, binder_loc: $2.loc, body: $4, loc: span($sloc) } }
  ;

function_literal -> Expr
  : function_literal_open function_literal_parameters ")" return_annotation layout_continuation_opt block_expression {
    FunctionLiteral(type_parameters=$1, parameters=$2, return_type=$4.return_type, effect=$4.effect, body=$6, loc=span($sloc))
  }
  ;

function_literal_open -> Array[TypeParameter]
  : "fn" "(" { [] }
  | "fn" type_parameter_bracket_list "(" { $2 }
  | "fn" type_parameter_bracket_list LAYOUT_NEWLINE "(" { $2 }
  ;

function_literal_parameters -> Array[FunctionLiteralParameter]
  : { [] }
  | non_empty_function_literal_parameters { $1 }
  ;

non_empty_function_literal_parameters -> Array[FunctionLiteralParameter]
  : function_literal_parameter { [ $1 ] }
  | non_empty_function_literal_parameters "," function_literal_parameter { comma_push($1, $3) }
  ;

function_literal_parameter -> FunctionLiteralParameter
  : function_literal_parameter_modifiers identifier local_type_annotation {
    { is_offered: $1, name: $2.name, name_loc: $2.loc, type_annotation: $3, loc: span($sloc) }
  }
  ;

function_literal_parameter_modifiers -> Bool
  : { false }
  | "offer" { true }
  ;

return_annotation -> ReturnAnnotation
  : { { return_type: None, effect: None } }
  | "->" type effect_annotation_opt {
    { return_type: Some($2), effect: $3 }
  }
  ;

builtin_expression -> Expr
  : "builtin" "(" STRING ")" {
    Builtin($3, loc=span($sloc))
  }
  ;

extern_expression -> Expr
  : "extern" "(" STRING ")" { Extern($3, loc=span($sloc)) }
  ;

pattern -> Pattern
  : PATTERN_IDENTIFIER_SLOT { abort("pattern completion slot token must not be shifted") }
  | "_" { Wildcard(span($sloc)) }
  | INT { integer_pattern_literal($1, span($sloc), negative=false) }
  | "-" INT { integer_pattern_literal($2, span($sloc), negative=true) }
  | DOUBLE { floating_pattern_literal($1, span($sloc), negative=false) }
  | "-" DOUBLE { floating_pattern_literal($2, span($sloc), negative=true) }
  | STRING { StringLiteral($1, loc=span($sloc)) }
  | CHAR { CharLiteral($1, loc=span($sloc)) }
  | "true" { BoolLiteral(true, loc=span($sloc)) }
  | "false" { BoolLiteral(false, loc=span($sloc)) }
  | "(" pattern "," tuple_pattern_tail ")" {
    Tuple(items=[$2] + $4, loc=span($sloc))
  }
  | IDENT %prec PATTERN_BINDING { Binding($1, loc=span($sloc)) }
  | IDENT variant_pattern_arguments { UnqualifiedVariant(variant=$1, variant_loc=span(($startpos, $endpos)).ascii_prefix($1.length()), type_binders=$2.type_binders, arguments=$2.arguments, loc=span(($startpos, $endpos))) }
  | struct_pattern { $1 }
  | nominal_type_name "tight ::" IDENT variant_pattern_arguments { QualifiedVariant(owner=$1, variant=$3, variant_loc=$1.loc().ascii_after(2, $3.length()), type_binders=$4.type_binders, arguments=$4.arguments, loc=span(($startpos, $endpos))) }
  ;

tuple_pattern_tail -> Array[Pattern]
  : MISSING_TUPLE_PATTERN_ITEM_ERROR { abort("missing tuple pattern item token must not be shifted") }
  | pattern { [ $1 ] }
  | tuple_pattern_tail "," pattern { comma_push($1, $3) }
  ;

struct_pattern -> Pattern
  : nominal_type_name "tight ::" "{" struct_pattern_fields "}" {
    Struct(owner=$1, fields=$4, loc=span($sloc))
  }
  ;

variant_pattern_arguments -> VariantPatternArguments
  : "(" pattern_list ")" { { type_binders: [], arguments: $2 } }
  | "[" non_empty_ident_list "]" "(" pattern_list ")" {
    { type_binders: $2, arguments: $5 }
  }
  | "[" non_empty_ident_list "]" LAYOUT_NEWLINE "(" pattern_list ")" {
    { type_binders: $2, arguments: $6 }
  }
  | LAYOUT_NEWLINE variant_pattern_arguments_after_newline { $2 }
  ;

variant_pattern_arguments_after_newline -> VariantPatternArguments
  : "(" pattern_list ")" { { type_binders: [], arguments: $2 } }
  | "[" non_empty_ident_list "]" "(" pattern_list ")" {
    { type_binders: $2, arguments: $5 }
  }
  | "[" non_empty_ident_list "]" LAYOUT_NEWLINE "(" pattern_list ")" {
    { type_binders: $2, arguments: $6 }
  }
  ;

non_empty_ident_list -> Array[TypeBinder]
  : identifier { [ { name: $1.name, loc: $1.loc } ] }
  | non_empty_ident_list "," identifier { comma_push($1, { name: $3.name, loc: $3.loc }) }
  | non_empty_ident_list "," { $1 }
  ;

pattern_list -> Array[Pattern]
  : { [] }
  | non_empty_pattern_list { $1 }
  ;

non_empty_pattern_list -> Array[Pattern]
  : pattern { [ $1 ] }
  | non_empty_pattern_list "," pattern { comma_push($1, $3) }
  | non_empty_pattern_list "," { $1 }
  ;

struct_pattern_fields -> Array[StructPatternField]
  : { [] }
  | non_empty_struct_pattern_fields { $1 }
  ;

non_empty_struct_pattern_fields -> Array[StructPatternField]
  : struct_pattern_field { [ $1 ] }
  | non_empty_struct_pattern_fields layout_list_separator struct_pattern_field { comma_push($1, $3) }
  | non_empty_struct_pattern_fields layout_list_separator { $1 }
  ;

struct_pattern_field -> StructPatternField
  : IDENT {
    Value(name=$1, pattern=None, loc=span($sloc))
  }
  | "_" {
    TypeWildcard(loc=span($sloc))
  }
  | IDENT ":" pattern {
    Value(name=$1, pattern=Some($3), loc=span($sloc))
  }
  ;

type_alias_result_kind_opt -> Kind?
  : { None }
  | ":" kind { Some($2) }
  ;
